From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ralf Boltshauser <ralf@example.com>
Date: Fri, 31 Jul 2026 00:05:00 +0200
Subject: [PATCH 7/7] fix: keep split clear lease arithmetic bounded

The enlarged delivery reserve made the old fixed two-second transparent clear
underflow when the reserve was subtracted. Express the transfer lifetime as
the reserve plus an explicit one-second transparent lease instead, and keep
clear retries bounded so a stalled write cannot block later scenes.
---
 app/src/split/bluetooth/central.c | 18 +++++++++++-------
 1 file changed, 11 insertions(+), 7 deletions(-)

diff --git a/app/src/split/bluetooth/central.c b/app/src/split/bluetooth/central.c
index 4eabc63a..4f438cd0 100644
--- a/app/src/split/bluetooth/central.c
+++ b/app/src/split/bluetooth/central.c
@@ -1151,10 +1151,12 @@ K_MUTEX_DEFINE(surface_mutex);
 #define SURFACE_SPLIT_LEASE_RESERVE_MS 4000
 #define SURFACE_SPLIT_SUBMIT_BUDGET_MS 3500
 #define SURFACE_SPLIT_DELIVERY_BUDGET_MS 3500
+#define SURFACE_SPLIT_CLEAR_LEASE_MS 1000
 BUILD_ASSERT(SURFACE_SPLIT_SUBMIT_BUDGET_MS <
              SURFACE_SPLIT_LEASE_RESERVE_MS);
 BUILD_ASSERT(SURFACE_SPLIT_DELIVERY_BUDGET_MS <=
              SURFACE_SPLIT_LEASE_RESERVE_MS);
+BUILD_ASSERT(SURFACE_SPLIT_CLEAR_LEASE_MS > 0);
 
 static void surface_requeue_inflight_locked(void) {
     if (surface_has_latest) {
@@ -1174,7 +1176,7 @@ static bool surface_inflight_retryable_locked(int64_t now) {
 
 static bool surface_abort_over_budget_locked(int64_t now,
                                              int64_t deadline) {
-    if (surface_inflight_is_clear || now < deadline) {
+    if (now < deadline) {
         return false;
     }
 
@@ -1303,7 +1305,8 @@ static void surface_send_work_handler(struct k_work *work) {
         surface_has_latest = false;
         uint32_t remaining;
         if (surface_inflight_is_clear) {
-            remaining = 2000U;
+            remaining = SURFACE_SPLIT_LEASE_RESERVE_MS +
+                        SURFACE_SPLIT_CLEAR_LEASE_MS;
             surface_inflight_expires_at = now + remaining;
         } else {
             remaining =
@@ -1587,12 +1590,13 @@ int zmk_split_surface_clear(uint32_t session_id, uint32_t generation,
         .session_id = session_id,
         .generation = generation,
         /*
-         * The sender reserves 1000 ms for split transfer. A transparent
-         * snapshot therefore needs 2000 ms on the central to retain a
-         * positive right-side lease. Extending an all-transparent scene
-         * cannot extend visible host lighting.
+         * A clear remains retryable even after its caller's lease expires.
+         * Give it exactly one bounded transfer reserve plus the short
+         * right-side clear lease; it cannot extend visible host lighting.
          */
-        .lease_ms = MAX(lease_ms, 2000U),
+        .lease_ms =
+            MAX(lease_ms, SURFACE_SPLIT_LEASE_RESERVE_MS +
+                              SURFACE_SPLIT_CLEAR_LEASE_MS),
         .brightness = 0,
         .cell_count = ZMK_CONTROL_SURFACE_HALF_CELL_COUNT,
     };
