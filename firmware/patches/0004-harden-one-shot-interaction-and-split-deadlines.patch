 #define SURFACE_MAX_FRAGMENT_CELLS 6
 #define SURFACE_MAX_FRAGMENTS 14
-#define SURFACE_FIRMWARE_BUILD_ID "g80m4a03"
+#define SURFACE_FIRMWARE_BUILD_ID "g80m4a05"
 #define SURFACE_TOPOLOGY_ID "glove80-rgb-80-v1"
 #define SURFACE_MAX_BRIGHTNESS 96
+#define SURFACE_INTERACTION_ARM_MS 5000
 
 enum surface_packet_kind {
     SURFACE_CAPABILITY_QUERY = 1,
@@ -151,6 +152,10 @@ static atomic_t interaction_event_sequence;
 static atomic_t interaction_mode;
 static atomic_t interaction_trigger_held;
 ATOMIC_DEFINE(interaction_pressed_cells, ZMK_CONTROL_SURFACE_CELL_COUNT);
+/* Guarded by surface_state_mutex. -1 means no one-shot cell is selected. */
+static int16_t interaction_selected_cell = -1;
+/* Guarded by surface_state_mutex; protects a new arm from a stale callback. */
+static int64_t interaction_expires_at;
 K_MUTEX_DEFINE(surface_state_mutex);
 
 static uint32_t split_scene_crc(struct zmk_split_surface_scene *scene);
@@ -159,9 +164,14 @@ static int enqueue_surface_event(uint8_t kind, const uint8_t *payload,
                                  size_t payload_len,
                                  uint32_t event_sequence);
 static void enter_guard_for_session_end(void);
+static int interaction_exit_locked(bool emit_event);
+static void arm_interaction_expiry_locked(void);
 static void expire_session_if_due(struct k_work *work);
 K_WORK_DELAYABLE_DEFINE(surface_session_expiry_work,
                         expire_session_if_due);
+static void expire_interaction_if_armed(struct k_work *work);
+K_WORK_DELAYABLE_DEFINE(surface_interaction_expiry_work,
+                        expire_interaction_if_armed);
 
 static uint16_t read_u16(const uint8_t *data) {
     return sys_get_le16(data);
@@ -275,6 +285,8 @@ static void fail_interaction_event_transport(void) {
     for (uint8_t cell = 0; cell < ZMK_CONTROL_SURFACE_CELL_COUNT; cell++) {
         atomic_clear_bit(interaction_pressed_cells, cell);
     }
+    interaction_selected_cell = -1;
+    interaction_expires_at = 0;
     if (atomic_get(&interaction_trigger_held)) {
         atomic_set(&interaction_mode, 2);
     } else {
@@ -356,12 +368,15 @@ static void arm_session_expiry(uint32_t session_id, uint32_t lease_ms) {
 
 static void enter_guard_for_session_end(void) {
     int mode = atomic_get(&interaction_mode);
+    k_work_cancel_delayable(&surface_interaction_expiry_work);
     if (mode == 1) {
         emit_interaction_mode_event(SURFACE_INTERACTION_EXITED);
     }
     for (uint8_t cell = 0; cell < ZMK_CONTROL_SURFACE_CELL_COUNT; cell++) {
         atomic_clear_bit(interaction_pressed_cells, cell);
     }
+    interaction_selected_cell = -1;
+    interaction_expires_at = 0;
     if (atomic_get(&interaction_trigger_held)) {
         atomic_set(&interaction_mode, 2);
     } else {
@@ -370,6 +385,58 @@ static void enter_guard_for_session_end(void) {
     }
 }
 
+static int interaction_exit_locked(bool emit_event) {
+    k_work_cancel_delayable(&surface_interaction_expiry_work);
+    interaction_expires_at = 0;
+    atomic_set(&interaction_trigger_held, 0);
+    if (emit_event && atomic_get(&interaction_mode) == 1) {
+        emit_interaction_mode_event(SURFACE_INTERACTION_EXITED);
+    }
+    atomic_set(&interaction_mode, 0);
+    for (uint8_t cell = 0; cell < ZMK_CONTROL_SURFACE_CELL_COUNT; cell++) {
+        atomic_clear_bit(interaction_pressed_cells, cell);
+    }
+    interaction_selected_cell = -1;
+    int err = zmk_keymap_layer_deactivate(ZMK_KEYMAP_LAYERS_LEN - 1);
+    zmk_rgb_underglow_control_surface_interaction_changed();
+    return err;
+}
+
+static void arm_interaction_expiry_locked(void) {
+    interaction_expires_at =
+        k_uptime_get() + SURFACE_INTERACTION_ARM_MS;
+    k_work_reschedule(&surface_interaction_expiry_work,
+                      K_MSEC(SURFACE_INTERACTION_ARM_MS));
+}
+
+static void expire_interaction_if_armed(struct k_work *work) {
+    ARG_UNUSED(work);
+    k_mutex_lock(&surface_state_mutex, K_FOREVER);
+    if (atomic_get(&interaction_mode) == 1) {
+        int64_t remaining = interaction_expires_at - k_uptime_get();
+        if (remaining > 0) {
+            /*
+             * A callback from the previous arm was already running when a
+             * new arm or key-down moved the deadline. It belongs to the new
+             * deadline only as a wake-up, never as permission to exit.
+             */
+            k_work_reschedule(&surface_interaction_expiry_work,
+                              K_MSEC(remaining));
+        } else {
+            if (interaction_selected_cell >= 0) {
+                uint8_t selected =
+                    (uint8_t)interaction_selected_cell;
+                atomic_clear_bit(interaction_pressed_cells, selected);
+                if (emit_cell_event(selected, false) < 0) {
+                    fail_interaction_event_transport();
+                }
+            }
+            interaction_exit_locked(true);
+        }
+    }
+    k_mutex_unlock(&surface_state_mutex);
+}
+
 bool zmk_control_surface_session_is_live(void) {
     k_mutex_lock(&surface_state_mutex, K_FOREVER);
     bool live =
@@ -378,6 +445,10 @@ bool zmk_control_surface_session_is_live(void) {
     return live;
 }
 
+bool zmk_control_surface_interaction_is_active(void) {
+    return atomic_get(&interaction_mode) == 1;
+}
+
 int zmk_control_surface_interaction_enter(void) {
     k_mutex_lock(&surface_state_mutex, K_FOREVER);
     if (atomic_get(&interaction_session_id) == 0 || !session_live() ||
@@ -402,22 +473,15 @@ int zmk_control_surface_interaction_enter(void) {
     if (err < 0) {
         fail_interaction_event_transport();
     }
+    zmk_rgb_underglow_control_surface_interaction_changed();
+    arm_interaction_expiry_locked();
     k_mutex_unlock(&surface_state_mutex);
     return 0;
 }
 
 int zmk_control_surface_interaction_exit(void) {
     k_mutex_lock(&surface_state_mutex, K_FOREVER);
-    atomic_set(&interaction_trigger_held, 0);
-    int mode = atomic_get(&interaction_mode);
-    if (mode == 1) {
-        emit_interaction_mode_event(SURFACE_INTERACTION_EXITED);
-    }
-    atomic_set(&interaction_mode, 0);
-    for (uint8_t cell = 0; cell < ZMK_CONTROL_SURFACE_CELL_COUNT; cell++) {
-        atomic_clear_bit(interaction_pressed_cells, cell);
-    }
-    int err = zmk_keymap_layer_deactivate(ZMK_KEYMAP_LAYERS_LEN - 1);
+    int err = interaction_exit_locked(true);
     k_mutex_unlock(&surface_state_mutex);
     return err;
 }
@@ -425,12 +489,7 @@ int zmk_control_surface_interaction_exit(void) {
 int zmk_control_surface_interaction_toggle(void) {
     k_mutex_lock(&surface_state_mutex, K_FOREVER);
     if (atomic_get(&interaction_mode) == 1) {
-        emit_interaction_mode_event(SURFACE_INTERACTION_EXITED);
-        atomic_set(&interaction_mode, 0);
-        for (uint8_t cell = 0; cell < ZMK_CONTROL_SURFACE_CELL_COUNT; cell++) {
-            atomic_clear_bit(interaction_pressed_cells, cell);
-        }
-        int err = zmk_keymap_layer_deactivate(ZMK_KEYMAP_LAYERS_LEN - 1);
+        int err = interaction_exit_locked(true);
         k_mutex_unlock(&surface_state_mutex);
         return err;
     }
@@ -440,6 +499,7 @@ int zmk_control_surface_interaction_toggle(void) {
         return -EACCES;
     }
     atomic_set(&interaction_trigger_held, 0);
+    interaction_selected_cell = -1;
     atomic_set(&interaction_mode, 1);
     next_nonzero_atomic(&interaction_epoch);
     int err = zmk_keymap_layer_activate(ZMK_KEYMAP_LAYERS_LEN - 1);
@@ -452,6 +512,8 @@ int zmk_control_surface_interaction_toggle(void) {
     if (err < 0) {
         fail_interaction_event_transport();
     }
+    zmk_rgb_underglow_control_surface_interaction_changed();
+    arm_interaction_expiry_locked();
     k_mutex_unlock(&surface_state_mutex);
     return err;
 }
@@ -467,17 +529,29 @@ int zmk_control_surface_cell_event(uint8_t cell_id, bool pressed) {
             k_mutex_unlock(&surface_state_mutex);
             return 0;
         }
+        if (interaction_selected_cell >= 0) {
+            k_mutex_unlock(&surface_state_mutex);
+            return 0;
+        }
         if (atomic_test_and_set_bit(interaction_pressed_cells, cell_id)) {
             k_mutex_unlock(&surface_state_mutex);
             return 0;
         }
+        interaction_selected_cell = cell_id;
         if (emit_cell_event(cell_id, true) < 0) {
             fail_interaction_event_transport();
+        } else {
+            /*
+             * The arm timeout is inactivity; after a press, the same bound is
+             * a maximum hold that guarantees a matching synthetic release.
+             */
+            arm_interaction_expiry_locked();
         }
         k_mutex_unlock(&surface_state_mutex);
         return 0;
     }
-    if (!atomic_test_and_clear_bit(interaction_pressed_cells, cell_id)) {
+    if (interaction_selected_cell != cell_id ||
+        !atomic_test_and_clear_bit(interaction_pressed_cells, cell_id)) {
         k_mutex_unlock(&surface_state_mutex);
         return 0;
     }
@@ -485,6 +559,7 @@ int zmk_control_surface_cell_event(uint8_t cell_id, bool pressed) {
         if (emit_cell_event(cell_id, false) < 0) {
             fail_interaction_event_transport();
         }
+        interaction_exit_locked(true);
     }
     k_mutex_unlock(&surface_state_mutex);
     return 0;
