@@ -76,6 +79,9 @@
 #define ZMK_HID_REPORT_ID_LEDS 0x01
 #define ZMK_HID_REPORT_ID_CONSUMER 0x02
 #define ZMK_HID_REPORT_ID_MOUSE 0x03
+#define ZMK_HID_REPORT_ID_CONTROL_SURFACE_OUTPUT 0x06
+#define ZMK_HID_REPORT_ID_CONTROL_SURFACE_INPUT 0x07
+#define ZMK_HID_REPORT_ID_CONTROL_SURFACE_CAPABILITY 0x08
 
