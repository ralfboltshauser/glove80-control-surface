+extern struct k_work_q service_work_q;
+
+struct surface_scene_envelope {
+    uint32_t connection_epoch;
+    struct zmk_split_surface_scene scene;
+};
+
+struct surface_ack_envelope {
+    uint32_t connection_epoch;
+    struct zmk_split_surface_ack ack;
+};
+
+static uint8_t surface_staging[ZMK_SPLIT_SURFACE_SNAPSHOT_BYTES];
+static uint8_t surface_next_fragment;
+static size_t surface_received;
+static struct surface_ack_envelope surface_current_ack;
+static struct bt_gatt_indicate_params surface_indicate_params;
+static atomic_t surface_indication_busy;
+static atomic_t surface_current_ack_valid;
+static atomic_t surface_connection_epoch;
+static struct bt_conn *surface_conn;
+K_MUTEX_DEFINE(surface_conn_mutex);
+
+K_MSGQ_DEFINE(surface_scene_queue, sizeof(struct surface_scene_envelope), 2, 4);
+K_MSGQ_DEFINE(surface_ack_queue, sizeof(struct surface_ack_envelope), 2, 4);
+
+static uint32_t surface_scene_crc(struct zmk_split_surface_scene *scene) {
+    uint32_t supplied = scene->crc32;
+    scene->crc32 = 0;
+    uint32_t calculated = crc32_ieee((const uint8_t *)scene, sizeof(*scene));
+    scene->crc32 = supplied;
+    return calculated;
+}
+
+static void surface_ack_work_handler(struct k_work *work);
+K_WORK_DEFINE(surface_ack_work, surface_ack_work_handler);
+static void surface_ack_retry_work_handler(struct k_work *work);
+K_WORK_DELAYABLE_DEFINE(surface_ack_retry_work,
+                        surface_ack_retry_work_handler);
+
+static void surface_ack_retry_work_handler(struct k_work *work) {
+    ARG_UNUSED(work);
+    k_work_submit_to_queue(&service_work_q, &surface_ack_work);
+}
+
+static void surface_indication_done(struct bt_conn *conn,
+                                    struct bt_gatt_indicate_params *params,
+                                    uint8_t err) {
+    if (err) {
+        LOG_WRN("Surface acknowledgement indication failed (%u)", err);
+    }
+}
+
+static void surface_indication_destroy(
+    struct bt_gatt_indicate_params *params) {
+    atomic_clear(&surface_current_ack_valid);
+    atomic_clear(&surface_indication_busy);
+    k_work_submit_to_queue(&service_work_q, &surface_ack_work);
+}
+
+static void surface_ack_work_handler(struct k_work *work) {
+    ARG_UNUSED(work);
+    if (!atomic_cas(&surface_indication_busy, 0, 1)) {
+        return;
+    }
+    if (!atomic_get(&surface_current_ack_valid)) {
+        if (k_msgq_get(&surface_ack_queue, &surface_current_ack,
+                       K_NO_WAIT) < 0) {
+            atomic_clear(&surface_indication_busy);
+            return;
+        }
+        atomic_set(&surface_current_ack_valid, 1);
+    }
+    if (surface_current_ack.connection_epoch !=
+        (uint32_t)atomic_get(&surface_connection_epoch)) {
+        atomic_clear(&surface_current_ack_valid);
+        atomic_clear(&surface_indication_busy);
+        k_work_submit_to_queue(&service_work_q, &surface_ack_work);
+        return;
+    }
+    k_mutex_lock(&surface_conn_mutex, K_FOREVER);
+    struct bt_conn *conn =
+        surface_conn ? bt_conn_ref(surface_conn) : NULL;
+    k_mutex_unlock(&surface_conn_mutex);
+    if (!conn) {
+        atomic_clear(&surface_current_ack_valid);
+        atomic_clear(&surface_indication_busy);
+        return;
+    }
+    surface_indicate_params = (struct bt_gatt_indicate_params){
+        .uuid = BT_UUID_DECLARE_128(ZMK_SPLIT_BT_SURFACE_UUID),
+        .func = surface_indication_done,
+        .destroy = surface_indication_destroy,
+        .data = &surface_current_ack.ack,
+        .len = sizeof(surface_current_ack.ack),
+    };
+    int err = bt_gatt_indicate(conn, &surface_indicate_params);
+    bt_conn_unref(conn);
+    if (err < 0) {
+        LOG_WRN("Unable to indicate surface acknowledgement (%d)", err);
+        atomic_clear(&surface_indication_busy);
+        k_work_reschedule_for_queue(&service_work_q,
+                                    &surface_ack_retry_work,
+                                    K_MSEC(10));
+    }
+}
+
+static void surface_scene_apply_work(struct k_work *work);
+K_WORK_DEFINE(surface_scene_work, surface_scene_apply_work);
+
+static void surface_scene_apply_work(struct k_work *work) {
+    struct surface_scene_envelope envelope;
+    while (k_msgq_get(&surface_scene_queue, &envelope, K_NO_WAIT) == 0) {
+        if (envelope.connection_epoch !=
+            (uint32_t)atomic_get(&surface_connection_epoch)) {
+            continue;
+        }
+        struct zmk_split_surface_scene *scene = &envelope.scene;
+        uint8_t result = ZMK_SPLIT_SURFACE_ACK_APPLIED;
+        if (scene->reserved != 0 ||
+            scene->cell_count != ZMK_CONTROL_SURFACE_HALF_CELL_COUNT ||
+            scene->lease_ms == 0 ||
+            scene->lease_ms > ZMK_CONTROL_SURFACE_MAX_LEASE_MS ||
+            scene->brightness > 96 ||
+            surface_scene_crc(scene) != scene->crc32) {
+            result = ZMK_SPLIT_SURFACE_ACK_INVALID_SCENE;
+        } else {
+            for (size_t i = 0; i < ARRAY_SIZE(scene->cells); i++) {
+                if (scene->cells[i].effect != 0xff &&
+                    scene->cells[i].effect > ZMK_CONTROL_SURFACE_EFFECT_PULSE) {
+                    result = ZMK_SPLIT_SURFACE_ACK_INVALID_SCENE;
+                    break;
+                }
+            }
+        }
+        if (result == ZMK_SPLIT_SURFACE_ACK_APPLIED &&
+            envelope.connection_epoch ==
+                (uint32_t)atomic_get(&surface_connection_epoch)) {
+            int err = zmk_control_surface_apply_local(
+                scene->cells, scene->brightness, scene->lease_ms);
+            if (err == -EAGAIN) {
+                zmk_control_surface_clear_local();
+                result = ZMK_SPLIT_SURFACE_ACK_POWER_SUPPRESSED;
+            } else if (err < 0) {
+                result = ZMK_SPLIT_SURFACE_ACK_DRIVER_ERROR;
+            }
+        }
+        struct surface_ack_envelope ack = {
+            .connection_epoch = envelope.connection_epoch,
+            .ack = {
+                .version = ZMK_SPLIT_SURFACE_VERSION,
+                .result = result,
+                .session_id = scene->session_id,
+                .generation = scene->generation,
+                .scene_crc32 = scene->crc32,
+            },
+        };
+        if (k_msgq_put(&surface_ack_queue, &ack, K_NO_WAIT) < 0) {
+            struct surface_ack_envelope discarded;
+            k_msgq_get(&surface_ack_queue, &discarded, K_NO_WAIT);
+            k_msgq_put(&surface_ack_queue, &ack, K_NO_WAIT);
+        }
+        k_work_submit_to_queue(&service_work_q, &surface_ack_work);
+    }
+}
+
+static ssize_t split_svc_surface(struct bt_conn *conn,
+                                 const struct bt_gatt_attr *attr,
+                                 const void *buf, uint16_t len,
+                                 uint16_t offset, uint8_t flags) {
+    if (offset != 0 || len != sizeof(struct zmk_split_surface_fragment)) {
+        surface_next_fragment = 0;
+        surface_received = 0;
+        return BT_GATT_ERR(BT_ATT_ERR_INVALID_ATTRIBUTE_LEN);
+    }
+    struct zmk_split_surface_fragment fragment;
+    memcpy(&fragment, buf, sizeof(fragment));
+    uint8_t expected_flags =
+        (fragment.fragment_index == 0 ? ZMK_SPLIT_SURFACE_FRAGMENT_FIRST : 0) |
+        (fragment.fragment_index == ZMK_SPLIT_SURFACE_FRAGMENT_COUNT - 1
+             ? ZMK_SPLIT_SURFACE_FRAGMENT_LAST
+             : 0);
+    uint8_t expected_length =
+        fragment.fragment_index == ZMK_SPLIT_SURFACE_FRAGMENT_COUNT - 1
+            ? ZMK_SPLIT_SURFACE_SNAPSHOT_BYTES %
+                  ZMK_SPLIT_SURFACE_FRAGMENT_PAYLOAD_BYTES
+            : ZMK_SPLIT_SURFACE_FRAGMENT_PAYLOAD_BYTES;
+    if (fragment.version != ZMK_SPLIT_SURFACE_VERSION ||
+        fragment.fragment_index >= ZMK_SPLIT_SURFACE_FRAGMENT_COUNT ||
+        fragment.flags != expected_flags ||
+        fragment.payload_length != expected_length) {
+        surface_next_fragment = 0;
+        surface_received = 0;
+        return BT_GATT_ERR(BT_ATT_ERR_VALUE_NOT_ALLOWED);
+    }
+    if (fragment.flags & ZMK_SPLIT_SURFACE_FRAGMENT_FIRST) {
+        if (fragment.fragment_index != 0) {
+            return BT_GATT_ERR(BT_ATT_ERR_VALUE_NOT_ALLOWED);
+        }
+        surface_next_fragment = 0;
+        surface_received = 0;
+        k_mutex_lock(&surface_conn_mutex, K_FOREVER);
+        if (surface_conn != conn) {
+            if (surface_conn) {
+                bt_conn_unref(surface_conn);
+            }
+            surface_conn = bt_conn_ref(conn);
+        }
+        k_mutex_unlock(&surface_conn_mutex);
+    }
+    if (fragment.fragment_index != surface_next_fragment ||
+        surface_received + fragment.payload_length > sizeof(surface_staging)) {
+        surface_next_fragment = 0;
+        surface_received = 0;
+        return BT_GATT_ERR(BT_ATT_ERR_VALUE_NOT_ALLOWED);
+    }
+    memcpy(&surface_staging[surface_received], fragment.payload,
+           fragment.payload_length);
+    surface_received += fragment.payload_length;
+    surface_next_fragment++;
+    if (fragment.flags & ZMK_SPLIT_SURFACE_FRAGMENT_LAST) {
+        if (surface_received != sizeof(struct zmk_split_surface_scene)) {
+            surface_next_fragment = 0;
+            surface_received = 0;
+            return BT_GATT_ERR(BT_ATT_ERR_VALUE_NOT_ALLOWED);
+        }
+        struct surface_scene_envelope envelope = {
+            .connection_epoch =
+                (uint32_t)atomic_get(&surface_connection_epoch),
+        };
+        memcpy(&envelope.scene, surface_staging, sizeof(envelope.scene));
+        if (k_msgq_put(&surface_scene_queue, &envelope, K_NO_WAIT) < 0) {
+            struct surface_scene_envelope discarded;
+            k_msgq_get(&surface_scene_queue, &discarded, K_NO_WAIT);
+            k_msgq_put(&surface_scene_queue, &envelope, K_NO_WAIT);
+        }
+        k_work_submit_to_queue(&service_work_q, &surface_scene_work);
+        surface_next_fragment = 0;
+        surface_received = 0;
+    }
+    return len;
+}
+
+static void split_svc_surface_ccc(const struct bt_gatt_attr *attr,
+                                  uint16_t value) {
+    LOG_DBG("surface indications %d", value);
+}
+
+static void surface_disconnect_work_handler(struct k_work *work) {
+    ARG_UNUSED(work);
+    zmk_control_surface_clear_local();
+}
+K_WORK_DEFINE(surface_disconnect_work, surface_disconnect_work_handler);
+
