 #define HID_ITEM_TAG_PUSH 0xA
@@ -101,6 +107,28 @@
 
 #define HID_USAGE16_SINGLE(a) HID_USAGE16((a & 0xFF), ((a >> 8) & 0xFF))
 
+#if IS_ENABLED(CONFIG_GLOVE80_CONTROL_SURFACE) &&                                             \
+    ((!IS_ENABLED(CONFIG_ZMK_SPLIT)) || IS_ENABLED(CONFIG_ZMK_SPLIT_ROLE_CENTRAL))
+#define ZMK_HID_CONTROL_SURFACE_REPORT_DESCRIPTOR                                              \
+    0x06, 0x60, 0xFF, HID_USAGE(0x10), HID_COLLECTION(HID_COLLECTION_APPLICATION),            \
+        HID_REPORT_ID(ZMK_HID_REPORT_ID_CONTROL_SURFACE_OUTPUT), HID_USAGE(0x11),               \
+        HID_LOGICAL_MIN8(0x00), HID_LOGICAL_MAX16(0xFF, 0x00), HID_REPORT_SIZE(0x08),           \
+        HID_REPORT_COUNT(0x3F),                                                                 \
+        HID_OUTPUT(ZMK_HID_MAIN_VAL_DATA | ZMK_HID_MAIN_VAL_VAR | ZMK_HID_MAIN_VAL_ABS),       \
+        HID_REPORT_ID(ZMK_HID_REPORT_ID_CONTROL_SURFACE_INPUT), HID_USAGE(0x12),                \
+        HID_REPORT_SIZE(0x08), HID_REPORT_COUNT(0x3F),                                          \
+        HID_INPUT(ZMK_HID_MAIN_VAL_DATA | ZMK_HID_MAIN_VAL_VAR | ZMK_HID_MAIN_VAL_ABS),        \
+        HID_REPORT_ID(ZMK_HID_REPORT_ID_CONTROL_SURFACE_CAPABILITY), HID_USAGE(0x13),           \
+        HID_REPORT_SIZE(0x08), HID_REPORT_COUNT(0x3F),                                          \
+        HID_FEATURE(ZMK_HID_MAIN_VAL_DATA | ZMK_HID_MAIN_VAL_VAR | ZMK_HID_MAIN_VAL_ABS),      \
+        HID_END_COLLECTION
+
+enum {
+    ZMK_HID_CONTROL_SURFACE_REPORT_DESCRIPTOR_BYTES =
+        sizeof((const uint8_t[]){ZMK_HID_CONTROL_SURFACE_REPORT_DESCRIPTOR}),
+};
+#endif
+
 static const uint8_t zmk_hid_report_desc[] = {
     HID_USAGE_PAGE(HID_USAGE_GEN_DESKTOP),
     HID_USAGE(HID_USAGE_GD_KEYBOARD),
@@ -253,8 +281,29 @@ static const uint8_t zmk_hid_report_desc[] = {
     HID_END_COLLECTION,
     HID_END_COLLECTION,
 #endif // IS_ENABLED(CONFIG_ZMK_POINTING)
+
+#if IS_ENABLED(CONFIG_GLOVE80_CONTROL_SURFACE) &&                                             \
+    ((!IS_ENABLED(CONFIG_ZMK_SPLIT)) || IS_ENABLED(CONFIG_ZMK_SPLIT_ROLE_CENTRAL))
+    /*
+     * One vendor-defined top-level collection is appended to the ordinary
+     * keyboard descriptor. macOS/hidapi exposes the combined device under the
+     * keyboard usage, so discovery uses feature report 8 instead of usage
+     * metadata.
+     */
+    ZMK_HID_CONTROL_SURFACE_REPORT_DESCRIPTOR,
+#endif
 };
 
+#if IS_ENABLED(CONFIG_GLOVE80_CONTROL_SURFACE)
+struct zmk_hid_control_surface_report {
+    uint8_t report_id;
+    uint8_t body[ZMK_CONTROL_SURFACE_REPORT_BODY_BYTES];
+} __packed;
+
+BUILD_ASSERT(sizeof(struct zmk_hid_control_surface_report) == 64,
+             "Control-surface HID report must include one ID and 63 body bytes");
+#endif
+
 #if IS_ENABLED(CONFIG_ZMK_USB_BOOT)
 
 #define HID_ERROR_ROLLOVER 0x1
