diff --git a/app/include/zmk/control_surface.h b/app/include/zmk/control_surface.h
new file mode 100644
index 0000000000000000000000000000000000000000..d762bbb8fdb9bc80cd5e244a4ea8fa6aef1f50f8
--- /dev/null
+++ b/app/include/zmk/control_surface.h
@@ -0,0 +1,45 @@
+/*
+ * Ephemeral Glove80 control surface.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#pragma once
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <zephyr/sys/util.h>
+
+#define ZMK_CONTROL_SURFACE_CELL_COUNT 80
+#define ZMK_CONTROL_SURFACE_HALF_CELL_COUNT 40
+#define ZMK_CONTROL_SURFACE_REPORT_BODY_BYTES 63
+#define ZMK_CONTROL_SURFACE_MAX_CHANNEL 16
+#define ZMK_CONTROL_SURFACE_MAX_LEASE_MS 60000U
+
+enum zmk_control_surface_effect {
+    ZMK_CONTROL_SURFACE_EFFECT_SOLID = 0,
+    ZMK_CONTROL_SURFACE_EFFECT_PULSE = 1,
+    ZMK_CONTROL_SURFACE_EFFECT_TRANSPARENT = 0xff,
+};
+
+struct zmk_control_surface_cell {
+    uint8_t red;
+    uint8_t green;
+    uint8_t blue;
+    uint8_t effect;
+} __packed;
+
+int zmk_control_surface_process_hid_report(const uint8_t *body, size_t len);
+void zmk_control_surface_get_capability_report(uint8_t *body, size_t len);
+void zmk_control_surface_get_last_input_report(uint8_t *body, size_t len);
+
+int zmk_control_surface_apply_local(const struct zmk_control_surface_cell *cells,
+                                    uint8_t brightness, uint32_t lease_ms);
+int zmk_control_surface_clear_local(void);
+bool zmk_control_surface_local_is_active(void);
+
+bool zmk_control_surface_session_is_live(void);
+int zmk_control_surface_interaction_enter(void);
+int zmk_control_surface_interaction_exit(void);
+int zmk_control_surface_cell_event(uint8_t cell_id, bool pressed);
