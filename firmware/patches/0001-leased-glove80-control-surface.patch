diff --git a/app/src/behaviors/behavior_control_surface.c b/app/src/behaviors/behavior_control_surface.c
new file mode 100644
index 0000000000000000000000000000000000000000..a9c8854054f327b63192314787a58c9b29ba4fd0
--- /dev/null
+++ b/app/src/behaviors/behavior_control_surface.c
@@ -0,0 +1,125 @@
+/*
+ * Leased Glove80 control-surface behaviors.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#include <zephyr/device.h>
+#include <zephyr/devicetree.h>
+#include <zephyr/logging/log.h>
+
+#include <drivers/behavior.h>
+#include <zmk/behavior.h>
+#include <zmk/control_surface.h>
+#include <zmk/keymap.h>
+
+LOG_MODULE_DECLARE(zmk, CONFIG_ZMK_LOG_LEVEL);
+
+#define TRIGGER_COMPAT zmk_behavior_control_surface_trigger
+#define KEY_COMPAT zmk_behavior_control_surface_key
+
+struct surface_trigger_config {
+    const char *fallback_behavior_dev;
+};
+
+struct surface_trigger_data {
+    bool captured;
+};
+
+static int invoke_fallback(const struct surface_trigger_config *config,
+                           struct zmk_behavior_binding *binding,
+                           struct zmk_behavior_binding_event event,
+                           bool pressed) {
+    struct zmk_behavior_binding fallback = {
+        .behavior_dev = config->fallback_behavior_dev,
+        .param1 = binding->param1,
+        .param2 = binding->param2,
+    };
+    return zmk_behavior_invoke_binding(&fallback, event, pressed);
+}
+
+static int trigger_pressed(struct zmk_behavior_binding *binding,
+                           struct zmk_behavior_binding_event event) {
+    const struct device *dev = zmk_behavior_get_binding(binding->behavior_dev);
+    struct surface_trigger_data *data = dev->data;
+    const struct surface_trigger_config *config = dev->config;
+
+    if (!zmk_control_surface_session_is_live()) {
+        data->captured = false;
+        return invoke_fallback(config, binding, event, true);
+    }
+
+    int err = zmk_control_surface_interaction_enter();
+    if (err < 0) {
+        data->captured = false;
+        return invoke_fallback(config, binding, event, true);
+    }
+    data->captured = true;
+    return ZMK_BEHAVIOR_OPAQUE;
+}
+
+static int trigger_released(struct zmk_behavior_binding *binding,
+                            struct zmk_behavior_binding_event event) {
+    const struct device *dev = zmk_behavior_get_binding(binding->behavior_dev);
+    struct surface_trigger_data *data = dev->data;
+    const struct surface_trigger_config *config = dev->config;
+
+    if (!data->captured) {
+        return invoke_fallback(config, binding, event, false);
+    }
+    data->captured = false;
+    zmk_control_surface_interaction_exit();
+    return ZMK_BEHAVIOR_OPAQUE;
+}
+
+static const struct behavior_driver_api trigger_driver_api = {
+    .binding_pressed = trigger_pressed,
+    .binding_released = trigger_released,
+};
+
+#define TRIGGER_INST(n)                                                    \
+    static struct surface_trigger_data surface_trigger_data_##n;           \
+    static const struct surface_trigger_config surface_trigger_config_##n = { \
+        .fallback_behavior_dev =                                           \
+            DEVICE_DT_NAME(DT_PHANDLE(DT_DRV_INST(n), fallback)),          \
+    };                                                                     \
+    BEHAVIOR_DT_INST_DEFINE(n, NULL, NULL, &surface_trigger_data_##n,       \
+                            &surface_trigger_config_##n, POST_KERNEL,       \
+                            CONFIG_KERNEL_INIT_PRIORITY_DEFAULT,            \
+                            &trigger_driver_api);
+
+#define DT_DRV_COMPAT TRIGGER_COMPAT
+DT_INST_FOREACH_STATUS_OKAY(TRIGGER_INST)
+#undef DT_DRV_COMPAT
+
+static int surface_key_pressed(struct zmk_behavior_binding *binding,
+                               struct zmk_behavior_binding_event event) {
+    if (binding->param1 >= ZMK_CONTROL_SURFACE_CELL_COUNT) {
+        return -EINVAL;
+    }
+    zmk_control_surface_cell_event((uint8_t)binding->param1, true);
+    return ZMK_BEHAVIOR_OPAQUE;
+}
+
+static int surface_key_released(struct zmk_behavior_binding *binding,
+                                struct zmk_behavior_binding_event event) {
+    if (binding->param1 >= ZMK_CONTROL_SURFACE_CELL_COUNT) {
+        return -EINVAL;
+    }
+    zmk_control_surface_cell_event((uint8_t)binding->param1, false);
+    return ZMK_BEHAVIOR_OPAQUE;
+}
+
+static const struct behavior_driver_api surface_key_driver_api = {
+    .binding_pressed = surface_key_pressed,
+    .binding_released = surface_key_released,
+};
+
+#define KEY_INST(n)                                                         \
+    BEHAVIOR_DT_INST_DEFINE(n, NULL, NULL, NULL, NULL, POST_KERNEL,         \
+                            CONFIG_KERNEL_INIT_PRIORITY_DEFAULT,             \
+                            &surface_key_driver_api);
+
+#define DT_DRV_COMPAT KEY_COMPAT
+DT_INST_FOREACH_STATUS_OKAY(KEY_INST)
+#undef DT_DRV_COMPAT
diff --git a/app/src/control_surface.c b/app/src/control_surface.c
new file mode 100644
index 0000000000000000000000000000000000000000..81d4361c0cfd4481b00f7dc24c658d5b720871a5
--- /dev/null
+++ b/app/src/control_surface.c
@@ -0,0 +1,1054 @@
+/*
+ * Ephemeral, bounded Glove80 control surface.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#include <errno.h>
+#include <string.h>
+
+#include <zephyr/kernel.h>
+#include <zephyr/logging/log.h>
+#include <zephyr/sys/atomic.h>
+#include <zephyr/sys/byteorder.h>
+#include <zephyr/sys/crc.h>
+
+#include <zmk/control_surface.h>
+#include <zmk/keymap.h>
+#include <zmk/rgb_underglow.h>
+#include <zmk/split/surface.h>
+
+#if (!IS_ENABLED(CONFIG_ZMK_SPLIT)) || IS_ENABLED(CONFIG_ZMK_SPLIT_ROLE_CENTRAL)
+#include <zmk/hid.h>
+#include <zmk/usb_hid.h>
+#endif
+
+LOG_MODULE_DECLARE(zmk, CONFIG_ZMK_LOG_LEVEL);
+
+__weak int zmk_split_surface_submit(
+    const struct zmk_split_surface_scene *scene) {
+    return -ENOTSUP;
+}
+
+__weak int zmk_split_surface_clear(uint32_t session_id, uint32_t generation,
+                                   uint32_t lease_ms) {
+    return -ENOTSUP;
+}
+
+#define SURFACE_MAGIC_0 0x47
+#define SURFACE_MAGIC_1 0x38
+#define SURFACE_PROTOCOL_VERSION 2
+#define SURFACE_HEADER_BYTES 8
+#define SURFACE_CHECKSUM_BYTES 4
+#define SURFACE_MAX_PACKET_BYTES ZMK_CONTROL_SURFACE_REPORT_BODY_BYTES
+#define SURFACE_MAX_FRAGMENT_CELLS 6
+#define SURFACE_MAX_FRAGMENTS 14
+#define SURFACE_FIRMWARE_BUILD_ID "g80m4a01"
+#define SURFACE_TOPOLOGY_ID "glove80-rgb-80-v1"
+#define SURFACE_MAX_BRIGHTNESS 96
+
+enum surface_packet_kind {
+    SURFACE_CAPABILITY_QUERY = 1,
+    SURFACE_OPEN_SESSION = 2,
+    SURFACE_RENEW_SESSION = 3,
+    SURFACE_SCENE_FRAGMENT = 4,
+    SURFACE_SCENE_COMMIT = 5,
+    SURFACE_CLOSE_SESSION = 6,
+    SURFACE_CELL_EVENT = 7,
+    SURFACE_CAPABILITY_RESPONSE = 8,
+    SURFACE_STATUS_QUERY = 9,
+    SURFACE_STATUS_RESPONSE = 10,
+    SURFACE_COMMAND_RESULT = 11,
+    SURFACE_DEVICE_ERROR = 12,
+    SURFACE_INTERACTION_ENTERED = 13,
+    SURFACE_INTERACTION_EXITED = 14,
+    SURFACE_SCENE_EXPIRED = 15,
+};
+
+enum surface_command_result {
+    SURFACE_RESULT_ACCEPTED = 0,
+    SURFACE_RESULT_APPLIED = 1,
+    SURFACE_RESULT_PARTIAL = 2,
+    SURFACE_RESULT_CLOSED = 3,
+};
+
+enum surface_session_status {
+    SURFACE_SESSION_ACTIVE = 0,
+    SURFACE_SESSION_EXPIRED = 1,
+    SURFACE_SESSION_UNKNOWN = 2,
+};
+
+enum surface_right_status {
+    SURFACE_RIGHT_ABSENT = 0,
+    SURFACE_RIGHT_INCOMPATIBLE = 1,
+    SURFACE_RIGHT_SYNCING = 2,
+    SURFACE_RIGHT_APPLIED = 3,
+    SURFACE_RIGHT_POWER_LIMITED = 4,
+};
+
+enum surface_device_error {
+    SURFACE_ERROR_INVALID_PACKET = 0,
+    SURFACE_ERROR_UNSUPPORTED_VERSION = 1,
+    SURFACE_ERROR_SESSION_EXPIRED = 2,
+    SURFACE_ERROR_INCOMPATIBLE_RIGHT = 3,
+    SURFACE_ERROR_ELECTRICAL_LIMIT = 4,
+    SURFACE_ERROR_SESSION_BUSY = 5,
+};
+
+struct staged_scene {
+    bool active;
+    uint32_t generation;
+    uint8_t fragment_count;
+    uint8_t total_cells;
+    uint16_t fragment_mask;
+    uint16_t fragment_crc[SURFACE_MAX_FRAGMENTS];
+    uint8_t cell_bitmap[ZMK_CONTROL_SURFACE_CELL_COUNT / 8];
+    struct zmk_control_surface_cell cells[ZMK_CONTROL_SURFACE_CELL_COUNT];
+    uint8_t received_cells;
+};
+
+static int apply_local(const struct zmk_control_surface_cell *cells,
+                       uint8_t brightness, uint32_t lease_ms) {
+    return zmk_rgb_underglow_control_surface_apply(cells, brightness,
+                                                   lease_ms);
+}
+
+int zmk_control_surface_apply_local(
+    const struct zmk_control_surface_cell *cells, uint8_t brightness,
+    uint32_t lease_ms) {
+    return apply_local(cells, brightness, lease_ms);
+}
+
+int zmk_control_surface_clear_local(void) {
+    return zmk_rgb_underglow_control_surface_clear();
+}
+
+bool zmk_control_surface_local_is_active(void) {
+    return zmk_rgb_underglow_control_surface_is_active();
+}
+
+#if (!IS_ENABLED(CONFIG_ZMK_SPLIT)) || IS_ENABLED(CONFIG_ZMK_SPLIT_ROLE_CENTRAL)
+
+static uint32_t active_session;
+static int64_t lease_expires_at;
+static uint32_t active_generation;
+static uint32_t active_scene_checksum;
+static uint32_t right_generation;
+static uint8_t right_status = SURFACE_RIGHT_ABSENT;
+static uint8_t active_brightness;
+static struct zmk_control_surface_cell
+    active_cells[ZMK_CONTROL_SURFACE_CELL_COUNT];
+static struct staged_scene staging;
+static uint16_t last_request_sequence;
+static uint32_t last_request_crc;
+static uint32_t last_request_session;
+static bool has_cached_response;
+static uint8_t cached_response[ZMK_CONTROL_SURFACE_REPORT_BODY_BYTES];
+static uint8_t last_input_report[ZMK_CONTROL_SURFACE_REPORT_BODY_BYTES];
+static atomic_t interaction_session_id;
+static atomic_t interaction_epoch;
+static atomic_t interaction_event_sequence;
+static atomic_t interaction_mode;
+static atomic_t interaction_trigger_held;
+ATOMIC_DEFINE(interaction_pressed_cells, ZMK_CONTROL_SURFACE_CELL_COUNT);
+K_MUTEX_DEFINE(surface_state_mutex);
+
+static uint32_t split_scene_crc(struct zmk_split_surface_scene *scene);
+static uint32_t next_nonzero_atomic(atomic_t *value);
+static int enqueue_surface_event(uint8_t kind, const uint8_t *payload,
+                                 size_t payload_len,
+                                 uint32_t event_sequence);
+static void enter_guard_for_session_end(void);
+static void expire_session_if_due(struct k_work *work);
+K_WORK_DELAYABLE_DEFINE(surface_session_expiry_work,
+                        expire_session_if_due);
+
+static uint16_t read_u16(const uint8_t *data) {
+    return sys_get_le16(data);
+}
+
+static uint32_t read_u32(const uint8_t *data) {
+    return sys_get_le32(data);
+}
+
+static void write_u16(uint8_t *data, uint16_t value) {
+    sys_put_le16(value, data);
+}
+
+static void write_u32(uint8_t *data, uint32_t value) {
+    sys_put_le32(value, data);
+}
+
+static bool session_live(void) {
+    return active_session != 0 && k_uptime_get() < lease_expires_at;
+}
+
+static uint32_t lease_remaining(void) {
+    if (!session_live()) {
+        return 0;
+    }
+    int64_t remaining = lease_expires_at - k_uptime_get();
+    return remaining > UINT32_MAX ? UINT32_MAX : (uint32_t)remaining;
+}
+
+static void clear_staging(void) {
+    memset(&staging, 0, sizeof(staging));
+    memset(staging.cells, 0xff, sizeof(staging.cells));
+}
+
+static void clear_active_scene(void) {
+    zmk_control_surface_clear_local();
+    zmk_split_surface_clear(active_session, active_generation, 1);
+    memset(active_cells, 0xff, sizeof(active_cells));
+    active_generation = 0;
+    active_scene_checksum = 0;
+    active_brightness = 0;
+    right_generation = 0;
+    right_status = SURFACE_RIGHT_ABSENT;
+    clear_staging();
+}
+
+static void expire_session_if_due(struct k_work *work) {
+    ARG_UNUSED(work);
+    k_mutex_lock(&surface_state_mutex, K_FOREVER);
+    if (session_live()) {
+        k_work_reschedule(&surface_session_expiry_work,
+                          K_MSEC(MAX(lease_remaining(), 1U)));
+        k_mutex_unlock(&surface_state_mutex);
+        return;
+    }
+    if (active_session == 0 ||
+        atomic_get(&interaction_session_id) == 0) {
+        k_mutex_unlock(&surface_state_mutex);
+        return;
+    }
+
+    uint32_t expired_session = active_session;
+    uint32_t expired_generation = active_generation;
+    enter_guard_for_session_end();
+    clear_active_scene();
+    if (expired_generation != 0) {
+        uint8_t payload[8];
+        uint32_t event_sequence =
+            next_nonzero_atomic(&interaction_event_sequence);
+        write_u32(payload, expired_session);
+        write_u32(&payload[4], expired_generation);
+        enqueue_surface_event(SURFACE_SCENE_EXPIRED, payload,
+                              sizeof(payload), event_sequence);
+    }
+    atomic_set(&interaction_session_id, 0);
+    k_mutex_unlock(&surface_state_mutex);
+}
+
+static size_t encode_packet(uint8_t *body, uint16_t sequence, uint8_t kind,
+                            const uint8_t *payload, size_t payload_len) {
+    memset(body, 0, ZMK_CONTROL_SURFACE_REPORT_BODY_BYTES);
+    body[0] = SURFACE_MAGIC_0;
+    body[1] = SURFACE_MAGIC_1;
+    body[2] = SURFACE_PROTOCOL_VERSION;
+    body[3] = kind;
+    write_u16(&body[4], sequence);
+    write_u16(&body[6], payload_len);
+    if (payload_len) {
+        memcpy(&body[SURFACE_HEADER_BYTES], payload, payload_len);
+    }
+    size_t checksum_offset = SURFACE_HEADER_BYTES + payload_len;
+    write_u32(&body[checksum_offset], crc32_ieee(body, checksum_offset));
+    return checksum_offset + SURFACE_CHECKSUM_BYTES;
+}
+
+static void send_surface_event_work(struct k_work *work);
+K_MSGQ_DEFINE(surface_event_queue, ZMK_CONTROL_SURFACE_REPORT_BODY_BYTES,
+              ZMK_CONTROL_SURFACE_CELL_COUNT + 8, 4);
+K_WORK_DEFINE(surface_event_work, send_surface_event_work);
+
+static int send_usb_report_with_retry(const uint8_t *body) {
+    int err = -EAGAIN;
+    for (uint8_t attempt = 0; attempt < 3 && err == -EAGAIN; attempt++) {
+        err = zmk_usb_hid_send_control_surface_report(
+            body, ZMK_CONTROL_SURFACE_REPORT_BODY_BYTES);
+    }
+    return err;
+}
+
+static void fail_interaction_event_transport(void) {
+    for (uint8_t cell = 0; cell < ZMK_CONTROL_SURFACE_CELL_COUNT; cell++) {
+        atomic_clear_bit(interaction_pressed_cells, cell);
+    }
+    if (atomic_get(&interaction_trigger_held)) {
+        atomic_set(&interaction_mode, 2);
+    } else {
+        atomic_set(&interaction_mode, 0);
+        zmk_keymap_layer_deactivate(ZMK_KEYMAP_LAYERS_LEN - 1);
+    }
+}
+
+static void send_surface_event_work(struct k_work *work) {
+    uint8_t body[ZMK_CONTROL_SURFACE_REPORT_BODY_BYTES];
+    while (k_msgq_get(&surface_event_queue, body, K_NO_WAIT) == 0) {
+        k_mutex_lock(&surface_state_mutex, K_FOREVER);
+        memcpy(last_input_report, body, sizeof(last_input_report));
+        int err = send_usb_report_with_retry(body);
+        if (err < 0) {
+            LOG_WRN("Unable to send control-surface event (%d)", err);
+            fail_interaction_event_transport();
+            k_msgq_purge(&surface_event_queue);
+            k_mutex_unlock(&surface_state_mutex);
+            return;
+        }
+        k_mutex_unlock(&surface_state_mutex);
+    }
+}
+
+static uint32_t next_nonzero_atomic(atomic_t *value) {
+    uint32_t next = (uint32_t)atomic_inc(value) + 1;
+    if (next == 0) {
+        atomic_set(value, 1);
+        next = 1;
+    }
+    return next;
+}
+
+static int enqueue_surface_event(uint8_t kind, const uint8_t *payload,
+                                 size_t payload_len,
+                                 uint32_t event_sequence) {
+    uint8_t body[ZMK_CONTROL_SURFACE_REPORT_BODY_BYTES];
+    encode_packet(body, (uint16_t)event_sequence, kind, payload,
+                  payload_len);
+    int err = k_msgq_put(&surface_event_queue, body, K_NO_WAIT);
+    if (err < 0) {
+        fail_interaction_event_transport();
+        LOG_ERR("Control-surface event queue full; failing interaction closed");
+        return err;
+    }
+    k_work_submit(&surface_event_work);
+    return 0;
+}
+
+static int emit_interaction_mode_event(uint8_t kind) {
+    uint8_t payload[12];
+    uint32_t event_sequence =
+        next_nonzero_atomic(&interaction_event_sequence);
+    write_u32(payload, (uint32_t)atomic_get(&interaction_session_id));
+    write_u32(&payload[4], event_sequence);
+    write_u32(&payload[8], (uint32_t)atomic_get(&interaction_epoch));
+    return enqueue_surface_event(kind, payload, sizeof(payload),
+                                 event_sequence);
+}
+
+static int emit_cell_event(uint8_t cell_id, bool pressed) {
+    uint8_t payload[14];
+    uint32_t event_sequence =
+        next_nonzero_atomic(&interaction_event_sequence);
+    write_u32(payload, (uint32_t)atomic_get(&interaction_session_id));
+    write_u32(&payload[4], event_sequence);
+    write_u32(&payload[8], (uint32_t)atomic_get(&interaction_epoch));
+    payload[12] = cell_id;
+    payload[13] = pressed ? 0 : 1;
+    return enqueue_surface_event(SURFACE_CELL_EVENT, payload,
+                                 sizeof(payload), event_sequence);
+}
+
+static void arm_session_expiry(uint32_t session_id, uint32_t lease_ms) {
+    atomic_set(&interaction_session_id, session_id);
+    k_work_reschedule(&surface_session_expiry_work, K_MSEC(lease_ms));
+}
+
+static void enter_guard_for_session_end(void) {
+    int mode = atomic_get(&interaction_mode);
+    if (mode == 1) {
+        emit_interaction_mode_event(SURFACE_INTERACTION_EXITED);
+    }
+    for (uint8_t cell = 0; cell < ZMK_CONTROL_SURFACE_CELL_COUNT; cell++) {
+        atomic_clear_bit(interaction_pressed_cells, cell);
+    }
+    if (atomic_get(&interaction_trigger_held)) {
+        atomic_set(&interaction_mode, 2);
+    } else {
+        atomic_set(&interaction_mode, 0);
+        zmk_keymap_layer_deactivate(ZMK_KEYMAP_LAYERS_LEN - 1);
+    }
+}
+
+bool zmk_control_surface_session_is_live(void) {
+    k_mutex_lock(&surface_state_mutex, K_FOREVER);
+    bool live =
+        atomic_get(&interaction_session_id) != 0 && session_live();
+    k_mutex_unlock(&surface_state_mutex);
+    return live;
+}
+
+int zmk_control_surface_interaction_enter(void) {
+    if (!zmk_control_surface_session_is_live() ||
+        atomic_get(&interaction_mode) == 2) {
+        return -EACCES;
+    }
+    if (!atomic_cas(&interaction_mode, 0, 1)) {
+        return -EBUSY;
+    }
+    atomic_set(&interaction_trigger_held, 1);
+    next_nonzero_atomic(&interaction_epoch);
+    int err = zmk_keymap_layer_activate(ZMK_KEYMAP_LAYERS_LEN - 1);
+    if (err < 0) {
+        atomic_set(&interaction_mode, 0);
+        atomic_set(&interaction_trigger_held, 0);
+        return err;
+    }
+    err = emit_interaction_mode_event(SURFACE_INTERACTION_ENTERED);
+    if (err < 0) {
+        fail_interaction_event_transport();
+    }
+    return 0;
+}
+
+int zmk_control_surface_interaction_exit(void) {
+    atomic_set(&interaction_trigger_held, 0);
+    int mode = atomic_get(&interaction_mode);
+    if (mode == 1) {
+        emit_interaction_mode_event(SURFACE_INTERACTION_EXITED);
+    }
+    atomic_set(&interaction_mode, 0);
+    for (uint8_t cell = 0; cell < ZMK_CONTROL_SURFACE_CELL_COUNT; cell++) {
+        atomic_clear_bit(interaction_pressed_cells, cell);
+    }
+    return zmk_keymap_layer_deactivate(ZMK_KEYMAP_LAYERS_LEN - 1);
+}
+
+int zmk_control_surface_cell_event(uint8_t cell_id, bool pressed) {
+    if (cell_id >= ZMK_CONTROL_SURFACE_CELL_COUNT) {
+        return -EINVAL;
+    }
+    if (pressed) {
+        if (atomic_get(&interaction_mode) != 1 ||
+            !zmk_control_surface_session_is_live()) {
+            return 0;
+        }
+        if (atomic_test_and_set_bit(interaction_pressed_cells, cell_id)) {
+            return 0;
+        }
+        if (emit_cell_event(cell_id, true) < 0) {
+            fail_interaction_event_transport();
+        }
+        return 0;
+    }
+    if (!atomic_test_and_clear_bit(interaction_pressed_cells, cell_id)) {
+        return 0;
+    }
+    if (atomic_get(&interaction_mode) == 1) {
+        if (emit_cell_event(cell_id, false) < 0) {
+            fail_interaction_event_transport();
+        }
+    }
+    return 0;
+}
+
+static int emit_response(uint16_t sequence, uint8_t kind,
+                         const uint8_t *payload, size_t payload_len) {
+    encode_packet(last_input_report, sequence, kind, payload, payload_len);
+    memcpy(cached_response, last_input_report, sizeof(cached_response));
+    has_cached_response = true;
+    return send_usb_report_with_retry(last_input_report);
+}
+
+static int emit_error(uint16_t sequence, uint32_t session_id,
+                      uint8_t request_kind, uint8_t error) {
+    uint8_t payload[6];
+    write_u32(payload, session_id);
+    payload[4] = request_kind;
+    payload[5] = error;
+    return emit_response(sequence, SURFACE_DEVICE_ERROR, payload,
+                         sizeof(payload));
+}
+
+static int emit_command_result(uint16_t sequence, uint32_t session_id,
+                               uint8_t command, uint8_t result) {
+    uint8_t payload[14] = {0};
+    write_u32(payload, session_id);
+    payload[4] = command;
+    payload[5] = result;
+    if (command != SURFACE_OPEN_SESSION && command != SURFACE_CLOSE_SESSION) {
+        write_u32(&payload[6], active_generation);
+        write_u32(&payload[10], right_generation);
+    }
+    return emit_response(sequence, SURFACE_COMMAND_RESULT, payload,
+                         sizeof(payload));
+}
+
+static void encode_capabilities(uint8_t *payload, uint32_t session_id) {
+    size_t offset = 0;
+    write_u32(&payload[offset], session_id);
+    offset += 4;
+    write_u16(&payload[offset], SURFACE_PROTOCOL_VERSION);
+    offset += 2;
+    payload[offset++] = sizeof(SURFACE_TOPOLOGY_ID) - 1;
+    memcpy(&payload[offset], SURFACE_TOPOLOGY_ID,
+           sizeof(SURFACE_TOPOLOGY_ID) - 1);
+    offset += sizeof(SURFACE_TOPOLOGY_ID) - 1;
+    payload[offset++] = sizeof(SURFACE_FIRMWARE_BUILD_ID) - 1;
+    memcpy(&payload[offset], SURFACE_FIRMWARE_BUILD_ID,
+           sizeof(SURFACE_FIRMWARE_BUILD_ID) - 1);
+    offset += sizeof(SURFACE_FIRMWARE_BUILD_ID) - 1;
+    memset(&payload[offset], 0xff, ZMK_CONTROL_SURFACE_CELL_COUNT / 8);
+    offset += ZMK_CONTROL_SURFACE_CELL_COUNT / 8;
+    payload[offset++] = BIT(0) | BIT(1);
+    payload[offset++] = BIT(0) | BIT(1);
+    payload[offset++] = ZMK_CONTROL_SURFACE_CELL_COUNT;
+    write_u32(&payload[offset], ZMK_CONTROL_SURFACE_MAX_LEASE_MS);
+    offset += 4;
+    payload[offset++] = SURFACE_MAX_BRIGHTNESS;
+    __ASSERT(offset == 51, "Capability payload wire size changed");
+}
+
+void zmk_control_surface_get_capability_report(uint8_t *body, size_t len) {
+    if (!body || len != ZMK_CONTROL_SURFACE_REPORT_BODY_BYTES) {
+        return;
+    }
+    uint8_t payload[51];
+    encode_capabilities(payload, 1);
+    encode_packet(body, 0, SURFACE_CAPABILITY_RESPONSE, payload,
+                  sizeof(payload));
+}
+
+void zmk_control_surface_get_last_input_report(uint8_t *body, size_t len) {
+    if (!body || len != sizeof(last_input_report)) {
+        return;
+    }
+    k_mutex_lock(&surface_state_mutex, K_FOREVER);
+    memcpy(body, last_input_report, len);
+    k_mutex_unlock(&surface_state_mutex);
+}
+
+static bool require_live_session(uint32_t session_id) {
+    return session_live() && session_id == active_session;
+}
+
+static int process_open(uint16_t sequence, const uint8_t *payload,
+                        size_t payload_len) {
+    if (payload_len != 8) {
+        return emit_error(sequence, 1, SURFACE_OPEN_SESSION,
+                          SURFACE_ERROR_INVALID_PACKET);
+    }
+    uint32_t session_id = read_u32(payload);
+    uint32_t lease_ms = read_u32(&payload[4]);
+    if (session_id == 0 || lease_ms == 0 ||
+        lease_ms > ZMK_CONTROL_SURFACE_MAX_LEASE_MS) {
+        return emit_error(sequence, session_id ? session_id : 1,
+                          SURFACE_OPEN_SESSION, SURFACE_ERROR_INVALID_PACKET);
+    }
+    if (session_live() && session_id != active_session) {
+        return emit_error(sequence, session_id, SURFACE_OPEN_SESSION,
+                          SURFACE_ERROR_SESSION_BUSY);
+    }
+    if (!session_live()) {
+        enter_guard_for_session_end();
+        clear_active_scene();
+        active_session = session_id;
+    }
+    lease_expires_at = k_uptime_get() + lease_ms;
+    arm_session_expiry(session_id, lease_ms);
+    return emit_command_result(sequence, session_id, SURFACE_OPEN_SESSION,
+                               SURFACE_RESULT_ACCEPTED);
+}
+
+static int process_renew(uint16_t sequence, const uint8_t *payload,
+                         size_t payload_len) {
+    if (payload_len != 8) {
+        return emit_error(sequence, 1, SURFACE_RENEW_SESSION,
+                          SURFACE_ERROR_INVALID_PACKET);
+    }
+    uint32_t session_id = read_u32(payload);
+    uint32_t lease_ms = read_u32(&payload[4]);
+    if (!require_live_session(session_id)) {
+        return emit_error(sequence, session_id, SURFACE_RENEW_SESSION,
+                          SURFACE_ERROR_SESSION_EXPIRED);
+    }
+    if (lease_ms == 0 || lease_ms > ZMK_CONTROL_SURFACE_MAX_LEASE_MS) {
+        return emit_error(sequence, session_id, SURFACE_RENEW_SESSION,
+                          SURFACE_ERROR_INVALID_PACKET);
+    }
+    if (active_generation) {
+        struct zmk_control_surface_cell left[40];
+        struct zmk_split_surface_scene right = {
+            .session_id = session_id,
+            .generation = active_generation,
+            .lease_ms = lease_ms,
+            .brightness = active_brightness,
+            .cell_count = 40,
+        };
+        memcpy(left, active_cells, sizeof(left));
+        memcpy(right.cells, &active_cells[40], sizeof(right.cells));
+        int err = apply_local(left, active_brightness, lease_ms);
+        if (err < 0) {
+            return emit_error(sequence, session_id, SURFACE_RENEW_SESSION,
+                              SURFACE_ERROR_ELECTRICAL_LIMIT);
+        }
+        right.crc32 = split_scene_crc(&right);
+        err = zmk_split_surface_submit(&right);
+        right_generation = 0;
+        right_status =
+            err == 0 ? SURFACE_RIGHT_SYNCING : SURFACE_RIGHT_ABSENT;
+    }
+    lease_expires_at = k_uptime_get() + lease_ms;
+    arm_session_expiry(session_id, lease_ms);
+    return emit_command_result(sequence, session_id, SURFACE_RENEW_SESSION,
+                               SURFACE_RESULT_ACCEPTED);
+}
+
+static bool bitmap_has(const uint8_t *bitmap, uint8_t cell) {
+    return (bitmap[cell / 8] & BIT(cell % 8)) != 0;
+}
+
+static void bitmap_add(uint8_t *bitmap, uint8_t cell) {
+    bitmap[cell / 8] |= BIT(cell % 8);
+}
+
+static int process_fragment(uint16_t sequence, const uint8_t *payload,
+                            size_t payload_len) {
+    if (payload_len < 18 || (payload_len - 12) % 6 != 0) {
+        return emit_error(sequence, 1, SURFACE_SCENE_FRAGMENT,
+                          SURFACE_ERROR_INVALID_PACKET);
+    }
+    uint32_t session_id = read_u32(payload);
+    uint32_t generation = read_u32(&payload[4]);
+    uint8_t fragment_index = payload[8];
+    uint8_t fragment_count = payload[9];
+    uint8_t total_cells = payload[10];
+    uint8_t carried = payload[11];
+    if (!require_live_session(session_id)) {
+        return emit_error(sequence, session_id, SURFACE_SCENE_FRAGMENT,
+                          SURFACE_ERROR_SESSION_EXPIRED);
+    }
+    if (generation == 0 || total_cells == 0 ||
+        total_cells > ZMK_CONTROL_SURFACE_CELL_COUNT) {
+        return emit_error(sequence, session_id, SURFACE_SCENE_FRAGMENT,
+                          SURFACE_ERROR_INVALID_PACKET);
+    }
+    uint8_t expected_fragments =
+        (total_cells + SURFACE_MAX_FRAGMENT_CELLS - 1) /
+        SURFACE_MAX_FRAGMENT_CELLS;
+    uint8_t expected_carried =
+        fragment_index == expected_fragments - 1
+            ? total_cells - fragment_index * SURFACE_MAX_FRAGMENT_CELLS
+            : SURFACE_MAX_FRAGMENT_CELLS;
+    if (
+        fragment_count != expected_fragments ||
+        fragment_count > SURFACE_MAX_FRAGMENTS ||
+        fragment_index >= fragment_count || carried != expected_carried ||
+        payload_len != 12 + carried * 6) {
+        return emit_error(sequence, session_id, SURFACE_SCENE_FRAGMENT,
+                          SURFACE_ERROR_INVALID_PACKET);
+    }
+    if (!staging.active || staging.generation != generation) {
+        if (fragment_index != 0) {
+            return emit_error(sequence, session_id, SURFACE_SCENE_FRAGMENT,
+                              SURFACE_ERROR_INVALID_PACKET);
+        }
+        clear_staging();
+        staging.active = true;
+        staging.generation = generation;
+        staging.fragment_count = fragment_count;
+        staging.total_cells = total_cells;
+    }
+    if (staging.fragment_count != fragment_count ||
+        staging.total_cells != total_cells) {
+        clear_staging();
+        return emit_error(sequence, session_id, SURFACE_SCENE_FRAGMENT,
+                          SURFACE_ERROR_INVALID_PACKET);
+    }
+    uint16_t fragment_crc =
+        crc32_ieee(payload, payload_len) & UINT16_MAX;
+    if (staging.fragment_mask & BIT(fragment_index)) {
+        if (staging.fragment_crc[fragment_index] != fragment_crc) {
+            clear_staging();
+            return emit_error(sequence, session_id, SURFACE_SCENE_FRAGMENT,
+                              SURFACE_ERROR_INVALID_PACKET);
+        }
+        return emit_command_result(sequence, session_id,
+                                   SURFACE_SCENE_FRAGMENT,
+                                   SURFACE_RESULT_ACCEPTED);
+    }
+    for (uint8_t index = 0; index < carried; index++) {
+        size_t offset = 12 + index * 6;
+        uint8_t cell = payload[offset];
+        uint8_t effect = payload[offset + 4];
+        if (cell >= ZMK_CONTROL_SURFACE_CELL_COUNT ||
+            effect > ZMK_CONTROL_SURFACE_EFFECT_PULSE ||
+            payload[offset + 5] != 0 ||
+            bitmap_has(staging.cell_bitmap, cell)) {
+            clear_staging();
+            return emit_error(sequence, session_id, SURFACE_SCENE_FRAGMENT,
+                              SURFACE_ERROR_INVALID_PACKET);
+        }
+        staging.cells[cell] = (struct zmk_control_surface_cell){
+            .red = payload[offset + 1],
+            .green = payload[offset + 2],
+            .blue = payload[offset + 3],
+            .effect = effect,
+        };
+        bitmap_add(staging.cell_bitmap, cell);
+        staging.received_cells++;
+    }
+    staging.fragment_crc[fragment_index] = fragment_crc;
+    staging.fragment_mask |= BIT(fragment_index);
+    return emit_command_result(sequence, session_id, SURFACE_SCENE_FRAGMENT,
+                               SURFACE_RESULT_ACCEPTED);
+}
+
+static uint32_t staged_scene_checksum(void) {
+    static uint8_t bytes[ZMK_CONTROL_SURFACE_CELL_COUNT * 5];
+    size_t offset = 0;
+    for (uint8_t cell = 0; cell < ZMK_CONTROL_SURFACE_CELL_COUNT; cell++) {
+        if (!bitmap_has(staging.cell_bitmap, cell)) {
+            continue;
+        }
+        bytes[offset++] = cell;
+        bytes[offset++] = staging.cells[cell].red;
+        bytes[offset++] = staging.cells[cell].green;
+        bytes[offset++] = staging.cells[cell].blue;
+        bytes[offset++] = staging.cells[cell].effect;
+    }
+    return crc32_ieee(bytes, offset);
+}
+
+static uint32_t split_scene_crc(struct zmk_split_surface_scene *scene) {
+    scene->crc32 = 0;
+    return crc32_ieee((const uint8_t *)scene, sizeof(*scene));
+}
+
+static int commit_scene(uint32_t session_id, uint32_t generation,
+                        uint32_t lease_ms, uint8_t brightness) {
+    struct zmk_control_surface_cell left[40];
+    struct zmk_split_surface_scene right = {
+        .session_id = session_id,
+        .generation = generation,
+        .lease_ms = lease_ms,
+        .brightness = brightness,
+        .cell_count = 40,
+    };
+    memset(left, 0xff, sizeof(left));
+    memset(right.cells, 0xff, sizeof(right.cells));
+    for (uint8_t cell = 0; cell < ZMK_CONTROL_SURFACE_CELL_COUNT; cell++) {
+        if (!bitmap_has(staging.cell_bitmap, cell)) {
+            continue;
+        }
+        if (cell < 40) {
+            left[cell] = staging.cells[cell];
+        } else {
+            right.cells[cell - 40] = staging.cells[cell];
+        }
+    }
+    int err = apply_local(left, brightness, lease_ms);
+    if (err < 0) {
+        return err;
+    }
+    memset(active_cells, 0xff, sizeof(active_cells));
+    for (uint8_t cell = 0; cell < ZMK_CONTROL_SURFACE_CELL_COUNT; cell++) {
+        if (bitmap_has(staging.cell_bitmap, cell)) {
+            active_cells[cell] = staging.cells[cell];
+        }
+    }
+    active_brightness = brightness;
+    active_generation = generation;
+    active_scene_checksum = staged_scene_checksum();
+    lease_expires_at = k_uptime_get() + lease_ms;
+    arm_session_expiry(session_id, lease_ms);
+    right.crc32 = split_scene_crc(&right);
+    err = zmk_split_surface_submit(&right);
+    right_generation = 0;
+    right_status =
+        err == 0 ? SURFACE_RIGHT_SYNCING : SURFACE_RIGHT_ABSENT;
+    return 0;
+}
+
+static int process_commit(uint16_t sequence, const uint8_t *payload,
+                          size_t payload_len) {
+    if (payload_len != 19) {
+        return emit_error(sequence, 1, SURFACE_SCENE_COMMIT,
+                          SURFACE_ERROR_INVALID_PACKET);
+    }
+    uint32_t session_id = read_u32(payload);
+    uint32_t generation = read_u32(&payload[4]);
+    uint8_t fragment_count = payload[8];
+    uint8_t total_cells = payload[9];
+    uint32_t lease_ms = read_u32(&payload[10]);
+    uint8_t brightness = payload[14];
+    uint32_t expected_checksum = read_u32(&payload[15]);
+    if (!require_live_session(session_id)) {
+        return emit_error(sequence, session_id, SURFACE_SCENE_COMMIT,
+                          SURFACE_ERROR_SESSION_EXPIRED);
+    }
+    if (generation == 0 || lease_ms == 0 ||
+        lease_ms > ZMK_CONTROL_SURFACE_MAX_LEASE_MS ||
+        brightness > SURFACE_MAX_BRIGHTNESS) {
+        return emit_error(sequence, session_id, SURFACE_SCENE_COMMIT,
+                          SURFACE_ERROR_INVALID_PACKET);
+    }
+    if (fragment_count == 0 && total_cells == 0 &&
+        expected_checksum == crc32_ieee(NULL, 0)) {
+        if (active_generation == generation &&
+            (active_scene_checksum != expected_checksum ||
+             active_brightness != brightness)) {
+            return emit_error(sequence, session_id, SURFACE_SCENE_COMMIT,
+                              SURFACE_ERROR_INVALID_PACKET);
+        }
+        clear_staging();
+        int err = commit_scene(session_id, generation, lease_ms, brightness);
+        clear_staging();
+        if (err < 0) {
+            return emit_error(sequence, session_id, SURFACE_SCENE_COMMIT,
+                              err == -EAGAIN
+                                  ? SURFACE_ERROR_ELECTRICAL_LIMIT
+                                  : SURFACE_ERROR_INVALID_PACKET);
+        }
+        return emit_command_result(sequence, session_id,
+                                   SURFACE_SCENE_COMMIT,
+                                   SURFACE_RESULT_PARTIAL);
+    }
+    uint8_t canonical_fragments =
+        (total_cells + SURFACE_MAX_FRAGMENT_CELLS - 1) /
+        SURFACE_MAX_FRAGMENT_CELLS;
+    if (fragment_count == 0 || fragment_count > SURFACE_MAX_FRAGMENTS ||
+        total_cells == 0 ||
+        total_cells > ZMK_CONTROL_SURFACE_CELL_COUNT ||
+        fragment_count != canonical_fragments) {
+        return emit_error(sequence, session_id, SURFACE_SCENE_COMMIT,
+                          SURFACE_ERROR_INVALID_PACKET);
+    }
+    if (active_generation == generation &&
+        (active_scene_checksum != expected_checksum ||
+         active_brightness != brightness)) {
+        return emit_error(sequence, session_id, SURFACE_SCENE_COMMIT,
+                          SURFACE_ERROR_INVALID_PACKET);
+    }
+    uint16_t expected_mask = (uint16_t)(BIT(fragment_count) - 1);
+    if (!staging.active || staging.generation != generation ||
+        staging.fragment_count != fragment_count ||
+        staging.total_cells != total_cells ||
+        staging.received_cells != total_cells ||
+        staging.fragment_mask != expected_mask ||
+        staged_scene_checksum() != expected_checksum) {
+        clear_staging();
+        return emit_error(sequence, session_id, SURFACE_SCENE_COMMIT,
+                          SURFACE_ERROR_INVALID_PACKET);
+    }
+    int err = commit_scene(session_id, generation, lease_ms, brightness);
+    clear_staging();
+    if (err == -EAGAIN) {
+        return emit_error(sequence, session_id, SURFACE_SCENE_COMMIT,
+                          SURFACE_ERROR_ELECTRICAL_LIMIT);
+    }
+    if (err < 0) {
+        return emit_error(sequence, session_id, SURFACE_SCENE_COMMIT,
+                          SURFACE_ERROR_INVALID_PACKET);
+    }
+    return emit_command_result(
+        sequence, session_id, SURFACE_SCENE_COMMIT,
+        right_status == SURFACE_RIGHT_APPLIED ? SURFACE_RESULT_APPLIED
+                                              : SURFACE_RESULT_PARTIAL);
+}
+
+static int process_status(uint16_t sequence, const uint8_t *payload,
+                          size_t payload_len) {
+    if (payload_len != 4) {
+        return emit_error(sequence, 1, SURFACE_STATUS_QUERY,
+                          SURFACE_ERROR_INVALID_PACKET);
+    }
+    uint32_t session_id = read_u32(payload);
+    uint8_t response[22] = {0};
+    write_u32(response, session_id);
+    if (session_live() && session_id == active_session) {
+        response[4] = SURFACE_SESSION_ACTIVE;
+        write_u32(&response[5], lease_remaining());
+        write_u32(&response[9], active_generation);
+        write_u32(&response[13], right_generation);
+        response[17] = right_status;
+        if (atomic_get(&interaction_mode) == 1) {
+            write_u32(&response[18],
+                      (uint32_t)atomic_get(&interaction_epoch));
+        }
+    } else {
+        response[4] =
+            session_id == active_session ? SURFACE_SESSION_EXPIRED
+                                         : SURFACE_SESSION_UNKNOWN;
+        response[17] = SURFACE_RIGHT_ABSENT;
+    }
+    return emit_response(sequence, SURFACE_STATUS_RESPONSE, response,
+                         sizeof(response));
+}
+
+static int process_close(uint16_t sequence, const uint8_t *payload,
+                         size_t payload_len) {
+    if (payload_len != 4) {
+        return emit_error(sequence, 1, SURFACE_CLOSE_SESSION,
+                          SURFACE_ERROR_INVALID_PACKET);
+    }
+    uint32_t session_id = read_u32(payload);
+    if (!require_live_session(session_id)) {
+        return emit_error(sequence, session_id, SURFACE_CLOSE_SESSION,
+                          SURFACE_ERROR_SESSION_EXPIRED);
+    }
+    enter_guard_for_session_end();
+    k_work_cancel_delayable(&surface_session_expiry_work);
+    clear_active_scene();
+    active_session = 0;
+    lease_expires_at = 0;
+    atomic_set(&interaction_session_id, 0);
+    return emit_command_result(sequence, session_id, SURFACE_CLOSE_SESSION,
+                               SURFACE_RESULT_CLOSED);
+}
+
+static int process_request(const uint8_t *body) {
+    if (body[0] != SURFACE_MAGIC_0 || body[1] != SURFACE_MAGIC_1) {
+        return -EINVAL;
+    }
+    uint16_t sequence = read_u16(&body[4]);
+    uint16_t payload_len = read_u16(&body[6]);
+    size_t packet_len =
+        SURFACE_HEADER_BYTES + payload_len + SURFACE_CHECKSUM_BYTES;
+    if (packet_len > ZMK_CONTROL_SURFACE_REPORT_BODY_BYTES ||
+        packet_len < SURFACE_HEADER_BYTES + SURFACE_CHECKSUM_BYTES) {
+        return emit_error(sequence, 1, body[3],
+                          SURFACE_ERROR_INVALID_PACKET);
+    }
+    for (size_t index = packet_len;
+         index < ZMK_CONTROL_SURFACE_REPORT_BODY_BYTES; index++) {
+        if (body[index] != 0) {
+            return emit_error(sequence, 1, body[3],
+                              SURFACE_ERROR_INVALID_PACKET);
+        }
+    }
+    uint32_t supplied_crc = read_u32(&body[packet_len - 4]);
+    uint32_t calculated_crc = crc32_ieee(body, packet_len - 4);
+    if (supplied_crc != calculated_crc) {
+        return emit_error(sequence, 1, body[3],
+                          SURFACE_ERROR_INVALID_PACKET);
+    }
+    if (body[2] != SURFACE_PROTOCOL_VERSION) {
+        return emit_error(sequence, 1, body[3],
+                          SURFACE_ERROR_UNSUPPORTED_VERSION);
+    }
+    const uint8_t *payload = &body[SURFACE_HEADER_BYTES];
+    uint32_t request_session =
+        payload_len >= sizeof(uint32_t) ? read_u32(payload) : 1;
+    if (has_cached_response && sequence == last_request_sequence &&
+        request_session == last_request_session) {
+        if (supplied_crc == last_request_crc) {
+            memcpy(last_input_report, cached_response,
+                   sizeof(last_input_report));
+            return send_usb_report_with_retry(last_input_report);
+        }
+        return emit_error(sequence, 1, body[3],
+                          SURFACE_ERROR_INVALID_PACKET);
+    }
+    last_request_sequence = sequence;
+    last_request_crc = supplied_crc;
+    last_request_session = request_session;
+    switch (body[3]) {
+    case SURFACE_CAPABILITY_QUERY: {
+        if (payload_len != 4) {
+            return emit_error(sequence, 1, body[3],
+                              SURFACE_ERROR_INVALID_PACKET);
+        }
+        uint8_t response[51];
+        encode_capabilities(response, read_u32(payload));
+        return emit_response(sequence, SURFACE_CAPABILITY_RESPONSE, response,
+                             sizeof(response));
+    }
+    case SURFACE_OPEN_SESSION:
+        return process_open(sequence, payload, payload_len);
+    case SURFACE_RENEW_SESSION:
+        return process_renew(sequence, payload, payload_len);
+    case SURFACE_SCENE_FRAGMENT:
+        return process_fragment(sequence, payload, payload_len);
+    case SURFACE_SCENE_COMMIT:
+        return process_commit(sequence, payload, payload_len);
+    case SURFACE_CLOSE_SESSION:
+        return process_close(sequence, payload, payload_len);
+    case SURFACE_STATUS_QUERY:
+        return process_status(sequence, payload, payload_len);
+    default:
+        return emit_error(sequence, 1, body[3],
+                          SURFACE_ERROR_INVALID_PACKET);
+    }
+}
+
+static void process_report_work(struct k_work *work);
+K_MSGQ_DEFINE(surface_report_queue, ZMK_CONTROL_SURFACE_REPORT_BODY_BYTES, 4,
+              4);
+K_WORK_DEFINE(surface_report_work, process_report_work);
+
+static void process_report_work(struct k_work *work) {
+    uint8_t body[ZMK_CONTROL_SURFACE_REPORT_BODY_BYTES];
+    while (k_msgq_get(&surface_report_queue, body, K_NO_WAIT) == 0) {
+        k_mutex_lock(&surface_state_mutex, K_FOREVER);
+        process_request(body);
+        k_mutex_unlock(&surface_state_mutex);
+    }
+}
+
+int zmk_control_surface_process_hid_report(const uint8_t *body, size_t len) {
+    if (!body || len != ZMK_CONTROL_SURFACE_REPORT_BODY_BYTES) {
+        return -EINVAL;
+    }
+    int err = k_msgq_put(&surface_report_queue, body, K_NO_WAIT);
+    if (err < 0) {
+        return err;
+    }
+    return k_work_submit(&surface_report_work) < 0 ? -EIO : 0;
+}
+
+void zmk_control_surface_split_ack(const struct zmk_split_surface_ack *ack) {
+    k_mutex_lock(&surface_state_mutex, K_FOREVER);
+    if (!ack || ack->version != ZMK_SPLIT_SURFACE_VERSION ||
+        ack->session_id != active_session ||
+        ack->generation != active_generation) {
+        k_mutex_unlock(&surface_state_mutex);
+        return;
+    }
+    switch (ack->result) {
+    case ZMK_SPLIT_SURFACE_ACK_APPLIED:
+        right_generation = ack->generation;
+        right_status = SURFACE_RIGHT_APPLIED;
+        break;
+    case ZMK_SPLIT_SURFACE_ACK_POWER_SUPPRESSED:
+        right_generation = 0;
+        right_status = SURFACE_RIGHT_POWER_LIMITED;
+        break;
+    case ZMK_SPLIT_SURFACE_ACK_UNSUPPORTED_VERSION:
+        right_generation = 0;
+        right_status = SURFACE_RIGHT_INCOMPATIBLE;
+        break;
+    default:
+        right_generation = 0;
+        right_status = SURFACE_RIGHT_SYNCING;
+        break;
+    }
+    k_mutex_unlock(&surface_state_mutex);
+}
+
+void zmk_control_surface_split_disconnected(void) {
+    k_mutex_lock(&surface_state_mutex, K_FOREVER);
+    right_generation = 0;
+    right_status = SURFACE_RIGHT_ABSENT;
+    k_mutex_unlock(&surface_state_mutex);
+}
+
+#else
+
+int zmk_control_surface_process_hid_report(const uint8_t *body, size_t len) {
+    return -ENOTSUP;
+}
+
+void zmk_control_surface_get_capability_report(uint8_t *body, size_t len) {
+    if (body && len) {
+        memset(body, 0, len);
+    }
+}
+
+void zmk_control_surface_get_last_input_report(uint8_t *body, size_t len) {
+    if (body && len) {
+        memset(body, 0, len);
+    }
+}
+
+#endif
