+            (uint32_t)MIN(surface_inflight_expires_at - now,
+                          (int64_t)ZMK_CONTROL_SURFACE_MAX_LEASE_MS);
+        surface_inflight.lease_ms =
+            remaining - SURFACE_SPLIT_TRANSFER_BUDGET_MS;
+        surface_inflight.crc32 = 0;
+        surface_inflight.crc32 =
+            crc32_ieee((const uint8_t *)&surface_inflight,
+                       sizeof(surface_inflight));
+        surface_tx_epoch++;
+        if (surface_tx_epoch == 0) {
+            surface_tx_epoch = 1;
+        }
+        surface_sending = true;
+        surface_fragment_index = 0;
+        surface_early_ack_valid = false;
+    }
+
+    const size_t offset =
+        surface_fragment_index * ZMK_SPLIT_SURFACE_FRAGMENT_PAYLOAD_BYTES;
+    const size_t remaining = sizeof(surface_inflight) - offset;
+    const size_t payload_length =
+        MIN(remaining, ZMK_SPLIT_SURFACE_FRAGMENT_PAYLOAD_BYTES);
+
+    struct surface_tx_context *tx;
+    if (k_mem_slab_alloc(&surface_tx_slab, (void **)&tx, K_NO_WAIT) < 0) {
+        bool retry = surface_retry_count < 2;
+        surface_retry_count++;
+        if (!retry) {
+            surface_sending = false;
+        }
+        k_mutex_unlock(&surface_mutex);
+        if (retry) {
+            k_work_reschedule_for_queue(&split_central_split_run_q,
+                                        &surface_retry_work, K_MSEC(5));
+        } else {
+            zmk_control_surface_split_disconnected();
+        }
+        return;
+    }
+    memset(tx, 0, sizeof(*tx));
+    tx->epoch = surface_tx_epoch;
+    tx->fragment.version = ZMK_SPLIT_SURFACE_VERSION;
+    tx->fragment.flags =
+        (surface_fragment_index == 0
+             ? ZMK_SPLIT_SURFACE_FRAGMENT_FIRST
+             : 0) |
+        (surface_fragment_index ==
+                 ZMK_SPLIT_SURFACE_FRAGMENT_COUNT - 1
+             ? ZMK_SPLIT_SURFACE_FRAGMENT_LAST
+             : 0);
+    tx->fragment.fragment_index = surface_fragment_index;
+    tx->fragment.payload_length = payload_length;
+    memcpy(tx->fragment.payload,
+           ((const uint8_t *)&surface_inflight) + offset, payload_length);
+
+    struct bt_conn *conn = bt_conn_ref(surface_transport_conn);
+    uint16_t handle = surface_transport_handle;
+    surface_tx_pending = true;
+    k_mutex_unlock(&surface_mutex);
+
+    int err = bt_gatt_write_without_response_cb(
+        conn, handle, &tx->fragment, sizeof(tx->fragment), true,
+        surface_write_complete, tx);
+    bt_conn_unref(conn);
+    if (err < 0) {
+        k_mem_slab_free(&surface_tx_slab, tx);
+        LOG_WRN("Unable to stream control-surface fragment %u (%d)",
+                surface_fragment_index, err);
+        k_mutex_lock(&surface_mutex, K_FOREVER);
+        surface_tx_pending = false;
+        surface_sending = false;
+        surface_early_ack_valid = false;
+        bool retry =
+            surface_retry_count < 2 &&
+            surface_inflight_expires_at > k_uptime_get();
+        if (retry && !surface_has_latest) {
+            surface_latest = surface_inflight;
+            surface_latest_expires_at = surface_inflight_expires_at;
+            surface_has_latest = true;
+            surface_retry_count++;
+        }
+        k_mutex_unlock(&surface_mutex);
+        if (retry) {
+            k_work_reschedule_for_queue(&split_central_split_run_q,
+                                        &surface_retry_work, K_MSEC(5));
+        } else {
+            zmk_control_surface_split_disconnected();
+        }
+    }
+}
+
+static void surface_kick(void) {
+    k_mutex_lock(&surface_mutex, K_FOREVER);
+    bool ready = surface_transport_ready_locked();
+    k_mutex_unlock(&surface_mutex);
+    if (ready) {
+        k_work_submit_to_queue(&split_central_split_run_q,
+                               &surface_send_work);
+    }
+}
+
+static void surface_transport_connected(struct bt_conn *conn,
+                                        uint16_t handle) {
+    k_mutex_lock(&surface_mutex, K_FOREVER);
+    if (surface_transport_conn != conn) {
+        if (surface_transport_conn) {
+            bt_conn_unref(surface_transport_conn);
+        }
+        surface_transport_conn = bt_conn_ref(conn);
+    }
+    surface_transport_handle = handle;
+    k_mutex_unlock(&surface_mutex);
+}
+
+static void surface_transport_disconnected(void) {
+    k_mutex_lock(&surface_mutex, K_FOREVER);
+    if ((surface_sending || surface_waiting_ack) && !surface_has_latest) {
+        surface_latest = surface_inflight;
+        surface_latest_expires_at = surface_inflight_expires_at;
+        surface_has_latest = true;
+    }
+    surface_sending = false;
+    surface_tx_pending = false;
+    surface_waiting_ack = false;
+    surface_early_ack_valid = false;
+    surface_tx_epoch++;
+    surface_fragment_index = 0;
+    surface_transport_handle = 0;
+    if (surface_transport_conn) {
+        bt_conn_unref(surface_transport_conn);
+        surface_transport_conn = NULL;
+    }
+    k_work_cancel_delayable(&surface_ack_timeout_work);
+    k_work_cancel_delayable(&surface_retry_work);
+    k_mutex_unlock(&surface_mutex);
+}
+
+static bool surface_ack_matches_inflight(
+    const struct zmk_split_surface_ack *ack) {
+    return ack->session_id == surface_inflight.session_id &&
+           ack->generation == surface_inflight.generation &&
+           ack->scene_crc32 == surface_inflight.crc32;
+}
+
+static void surface_transport_accept_ack(
+    const struct zmk_split_surface_ack *ack) {
+    if (!ack || ack->version != ZMK_SPLIT_SURFACE_VERSION ||
+        ack->result > ZMK_SPLIT_SURFACE_ACK_POWER_SUPPRESSED) {
+        return;
+    }
+
+    k_mutex_lock(&surface_mutex, K_FOREVER);
+    bool matches = surface_ack_matches_inflight(ack);
+    bool early_phase =
+        surface_sending && surface_tx_pending &&
+        surface_fragment_index == ZMK_SPLIT_SURFACE_FRAGMENT_COUNT - 1;
+    if (matches && early_phase) {
+        surface_early_ack = *ack;
+        surface_early_ack_valid = true;
+        k_mutex_unlock(&surface_mutex);
+        return;
+    }
+    matches = matches && surface_waiting_ack;
+    bool publish_ack = matches && !surface_has_latest;
+    bool has_next = matches && surface_has_latest;
+    if (matches) {
+        surface_waiting_ack = false;
+        surface_retry_count = 0;
+        k_work_cancel_delayable(&surface_ack_timeout_work);
+    }
+    k_mutex_unlock(&surface_mutex);
+    if (publish_ack) {
+        zmk_control_surface_split_ack(ack);
+    }
+    if (has_next) {
+        surface_kick();
+    }
+}
+
+static void surface_ack_timeout_handler(struct k_work *work) {
+    ARG_UNUSED(work);
+    bool retry = false;
+    bool failed = false;
+
+    k_mutex_lock(&surface_mutex, K_FOREVER);
+    if (surface_waiting_ack) {
+        surface_waiting_ack = false;
+        int64_t now = k_uptime_get();
+        if (!surface_has_latest &&
+            surface_inflight_expires_at > now &&
+            surface_retry_count < 2) {
+            surface_latest = surface_inflight;
+            surface_latest_expires_at = surface_inflight_expires_at;
+            surface_has_latest = true;
+            surface_retry_count++;
+            retry = true;
+        } else if (surface_has_latest) {
+            surface_retry_count = 0;
+            retry = true;
+        } else {
+            failed = true;
+        }
+    }
+    k_mutex_unlock(&surface_mutex);
+
+    if (retry) {
+        surface_kick();
+    } else if (failed) {
+        zmk_control_surface_split_disconnected();
+    }
+}
+
+static void surface_retry_handler(struct k_work *work) {
+    ARG_UNUSED(work);
+    surface_kick();
+}
+
+int zmk_split_surface_submit(
+    const struct zmk_split_surface_scene *scene) {
+    if (!scene) {
+        return -EINVAL;
+    }
+
+    k_mutex_lock(&surface_mutex, K_FOREVER);
+    surface_latest = *scene;
+    surface_latest_expires_at = k_uptime_get() + scene->lease_ms;
+    surface_has_latest = true;
+    surface_retry_count = 0;
+    if (surface_waiting_ack) {
+        surface_waiting_ack = false;
+        k_work_cancel_delayable(&surface_ack_timeout_work);
+    }
+    k_mutex_unlock(&surface_mutex);
+
+    k_mutex_lock(&surface_mutex, K_FOREVER);
+    bool ready = surface_transport_ready_locked();
+    k_mutex_unlock(&surface_mutex);
+    surface_kick();
+    return ready ? 0 : -EAGAIN;
+}
+
+int zmk_split_surface_clear(uint32_t session_id, uint32_t generation,
+                            uint32_t lease_ms) {
+    struct zmk_split_surface_scene scene = {
+        .session_id = session_id,
+        .generation = generation,
+        /*
+         * The sender reserves 1000 ms for split transfer. A transparent
+         * snapshot therefore needs 2000 ms on the central to retain a
+         * positive right-side lease. Extending an all-transparent scene
+         * cannot extend visible host lighting.
+         */
+        .lease_ms = MAX(lease_ms, 2000U),
+        .brightness = 0,
+        .cell_count = ZMK_CONTROL_SURFACE_HALF_CELL_COUNT,
+    };
+    for (size_t i = 0; i < ARRAY_SIZE(scene.cells); i++) {
+        scene.cells[i].effect = ZMK_CONTROL_SURFACE_EFFECT_TRANSPARENT;
+    }
+    scene.crc32 = 0;
+    scene.crc32 = crc32_ieee((const uint8_t *)&scene, sizeof(scene));
+    return zmk_split_surface_submit(&scene);
+}
