diff --git a/app/include/zmk/split/surface.h b/app/include/zmk/split/surface.h
new file mode 100644
index 0000000000000000000000000000000000000000..0fa2e7d165b8c18faab5292f6e45d4c55c989d76
--- /dev/null
+++ b/app/include/zmk/split/surface.h
@@ -0,0 +1,82 @@
+/*
+ * Complete-scene transport between Glove80 halves.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+#include <zephyr/sys/util.h>
+#include <zmk/control_surface.h>
+
+#define ZMK_SPLIT_SURFACE_VERSION 1
+#define ZMK_SPLIT_SURFACE_SNAPSHOT_BYTES 180
+#define ZMK_SPLIT_SURFACE_FRAGMENT_PAYLOAD_BYTES 16
+#define ZMK_SPLIT_SURFACE_FRAGMENT_BYTES 20
+#define ZMK_SPLIT_SURFACE_FRAGMENT_COUNT 12
+
+#define ZMK_SPLIT_SURFACE_FRAGMENT_FIRST BIT(0)
+#define ZMK_SPLIT_SURFACE_FRAGMENT_LAST BIT(1)
+
+enum zmk_split_surface_ack_result {
+    ZMK_SPLIT_SURFACE_ACK_APPLIED = 0,
+    ZMK_SPLIT_SURFACE_ACK_UNSUPPORTED_VERSION = 1,
+    ZMK_SPLIT_SURFACE_ACK_INVALID_FRAGMENT = 2,
+    ZMK_SPLIT_SURFACE_ACK_INVALID_SCENE = 3,
+    ZMK_SPLIT_SURFACE_ACK_DRIVER_ERROR = 4,
+    ZMK_SPLIT_SURFACE_ACK_POWER_SUPPRESSED = 5,
+};
+
+struct zmk_split_surface_scene {
+    uint32_t session_id;
+    uint32_t generation;
+    uint32_t lease_ms;
+    uint8_t brightness;
+    uint8_t cell_count;
+    uint16_t reserved;
+    uint32_t crc32;
+    struct zmk_control_surface_cell cells[ZMK_CONTROL_SURFACE_HALF_CELL_COUNT];
+} __packed;
+
+struct zmk_split_surface_fragment {
+    uint8_t version;
+    uint8_t flags;
+    uint8_t fragment_index;
+    uint8_t payload_length;
+    uint8_t payload[ZMK_SPLIT_SURFACE_FRAGMENT_PAYLOAD_BYTES];
+} __packed;
+
+struct zmk_split_surface_ack {
+    uint8_t version;
+    uint8_t result;
+    uint16_t reserved;
+    uint32_t session_id;
+    uint32_t generation;
+    uint32_t scene_crc32;
+} __packed;
+
+BUILD_ASSERT(sizeof(struct zmk_split_surface_scene) ==
+                 ZMK_SPLIT_SURFACE_SNAPSHOT_BYTES,
+             "Split surface scene wire size changed");
+BUILD_ASSERT(ZMK_SPLIT_SURFACE_FRAGMENT_COUNT ==
+                 DIV_ROUND_UP(ZMK_SPLIT_SURFACE_SNAPSHOT_BYTES,
+                              ZMK_SPLIT_SURFACE_FRAGMENT_PAYLOAD_BYTES),
+             "Split surface fragment count must cover exactly one scene");
+BUILD_ASSERT(ZMK_SPLIT_SURFACE_SNAPSHOT_BYTES %
+                     ZMK_SPLIT_SURFACE_FRAGMENT_PAYLOAD_BYTES !=
+                 0,
+             "The final fragment is expected to be partial");
+BUILD_ASSERT(sizeof(struct zmk_split_surface_fragment) ==
+                 ZMK_SPLIT_SURFACE_FRAGMENT_BYTES,
+             "Split surface fragment must fit the default 23-byte ATT MTU");
+BUILD_ASSERT(sizeof(struct zmk_split_surface_ack) == 16,
+             "Split surface acknowledgement wire size changed");
+
+int zmk_split_surface_submit(const struct zmk_split_surface_scene *scene);
+int zmk_split_surface_clear(uint32_t session_id, uint32_t generation,
+                            uint32_t lease_ms);
+void zmk_control_surface_split_ack(const struct zmk_split_surface_ack *ack);
+void zmk_control_surface_split_disconnected(void);
+void zmk_split_surface_peripheral_disconnected(void);
