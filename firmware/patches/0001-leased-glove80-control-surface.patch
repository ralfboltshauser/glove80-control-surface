diff --git a/app/Kconfig b/app/Kconfig
index 01de7dcdcf5f6170dec021c3a515f3b14d63194b..598e68c228047bf8a69916f40661d2115bfaf5b7 100644
--- a/app/Kconfig
+++ b/app/Kconfig
@@ -110,6 +110,17 @@ config ZMK_HID_INDICATORS
       Enable HID indicators, used for detecting state of Caps/Scroll/Num Lock,
       Kata, and Compose.
 
+config GLOVE80_CONTROL_SURFACE
+    bool "Ephemeral Glove80 host control surface"
+    depends on (BOARD_GLOVE80_LH || BOARD_GLOVE80_RH)
+    depends on ZMK_RGB_UNDERGLOW
+    help
+      Add an explicitly enabled, non-persistent control surface for all forty
+      RGB cells on this half. The left half exposes the host-facing USB HID
+      protocol and relays complete right-half snapshots over the encrypted
+      ZMK split link. Every scene has a lease and restores the user's prior
+      RGB power state when it closes or expires.
+
 config ZMK_HID_SEPARATE_MOD_RELEASE_REPORT
     bool "Release Modifiers Separately"
     help
