+void zmk_rgb_underglow_control_surface_set_action_masks(
+    const uint8_t primary[5], const uint8_t secondary[5]) {
+    k_spinlock_key_t key = k_spin_lock(&control_surface_lock);
+    memcpy(control_surface_action_masks[0], primary, 5);
+    memcpy(control_surface_action_masks[1], secondary, 5);
+    k_spin_unlock(&control_surface_lock, key);
+    k_work_reschedule(&control_surface_tick_work, K_NO_WAIT);
+}
+
+void zmk_rgb_underglow_control_surface_set_interaction(bool active,
+                                                       uint8_t bank) {
+    k_spinlock_key_t key = k_spin_lock(&control_surface_lock);
+    control_surface_interaction_active = active;
+    control_surface_interaction_bank = bank > 1 ? 0 : bank;
+    if (!active) {
+        memset(control_surface_pressed_mask, 0,
+               sizeof(control_surface_pressed_mask));
+    }
+    k_spin_unlock(&control_surface_lock, key);
+    k_work_reschedule(&control_surface_tick_work, K_NO_WAIT);
+}
+
+void zmk_rgb_underglow_control_surface_position_event(uint8_t position,
+                                                       bool pressed) {
+    static int8_t local_trigger_position = -1;
+    static const uint8_t position_to_channel[80] = {
+        34,28,22,16,10,50,56,62,68,74,35,29,23,17,11,6,46,51,57,63,
+        69,75,36,30,24,18,12,7,47,52,58,64,70,76,37,31,25,19,13,8,
+        48,53,59,65,71,77,38,32,26,20,14,9,0,1,2,42,41,40,49,54,
+        60,66,72,78,39,33,27,21,15,3,4,5,45,44,43,55,61,67,73,79
+    };
+    if (position >= ARRAY_SIZE(position_to_channel)) {
+        return;
+    }
+    uint8_t channel = position_to_channel[position];
+#if IS_ENABLED(CONFIG_ZMK_SPLIT_ROLE_CENTRAL)
+    if (channel >= ZMK_CONTROL_SURFACE_HALF_CELL_COUNT) {
+        return;
+    }
+#else
+    if (channel < ZMK_CONTROL_SURFACE_HALF_CELL_COUNT) {
+        return;
+    }
+    channel -= ZMK_CONTROL_SURFACE_HALF_CELL_COUNT;
+    if (position == 75 || position == 76) {
+        if (pressed && local_trigger_position < 0 &&
+            control_surface_active_snapshot()) {
+            local_trigger_position = position;
+            zmk_rgb_underglow_control_surface_set_interaction(
+                true, position == 75 ? 0 : 1);
+            return;
+        } else if (!pressed && local_trigger_position == position) {
+            local_trigger_position = -1;
+            zmk_rgb_underglow_control_surface_set_interaction(false, 0);
+            return;
+        } else if (local_trigger_position < 0) {
+            return;
+        }
+        /* While one bank is held, the other modifier is an ordinary
+         * Control-layer action key and falls through to pressed feedback.
+         */
+    }
+#endif
+    k_spinlock_key_t key = k_spin_lock(&control_surface_lock);
+    if (control_surface_interaction_active) {
+        if (pressed) {
+            control_surface_pressed_mask[channel / 8] |= BIT(channel % 8);
+        } else {
+            control_surface_pressed_mask[channel / 8] &= ~BIT(channel % 8);
+        }
+    }
+    k_spin_unlock(&control_surface_lock, key);
+    k_work_reschedule(&control_surface_tick_work, K_NO_WAIT);
+}
